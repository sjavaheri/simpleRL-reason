[36m(main_task pid=2326006)[0m 
[36m(main_task pid=2326006)[0m \[ f(x) = -3x^2 + x - 4 \]
[36m(main_task pid=2326006)[0m \[ g(x) = -5x^2 + 3x - 8 \]
[36m(main_task pid=2326006)[0m \[ h(x) = 5x^2 + 5x + 1 \]

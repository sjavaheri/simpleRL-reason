[36m(main_task pid=2326006)[0m 
[36m(main_task pid=2326006)[0m draw(p--q--r--s--cycle);
[36m(main_task pid=2326006)[0m 
[36m(main_task pid=2326006)[0m draw(shift(1) * (p--s)); draw(shift(2) * (p--s));
[36m(main_task pid=2326006)[0m 
[36m(main_task pid=2326006)[0m label("$P$", p, NW); label("$Q$", q, NE); label("$R$", r, SE); label("$S$", s, SW);
[36m(main_task pid=2326006)[0m 
[36m(main_task pid=2326006)[0m [/asy]
[36m(main_task pid=2326006)[0m Please reason step by step, and put your final answer within \boxed{{}}.<|im_end|>

[36m(main_task pid=2326006)[0m \[
[36m(main_task pid=2326006)[0m 5^5 = 3125
[36m(main_task pid=2326006)[0m \]
[36m(main_task pid=2326006)[0m \[
[36m(main_task pid=2326006)[0m 6^4 = 46656
[36m(main_task pid=2326006)[0m \]
[36m(main_task pid=2326006)[0m \[

[36m(main_task pid=2326006)[0m 
[36m(main_task pid=2326006)[0m # We'll categorize our results here
[36m(main_task pid=2326006)[0m max_sch Schönflies_index = 1
[36m(main_task pid=2326006)[0m max_sch_finite = []
[36m(main_task pid=2326006)[0m max_sch_ia = {}
[36m(main_task pid=2326006)[0m max_sch_m24 = FiniteSet(1209, 3819, 5111, 6423, 9933, 29261, 39249, 50499, 51139)

[36m(main_task pid=2326006)[0m 6 + \frac{5}{C}C = 17
[36m(main_task pid=2326006)[0m \]
[36m(main_task pid=2326006)[0m 
[36m(main_task pid=2326006)[0m \[
[36m(main_task pid=2326006)[0m 6 + 5 = 17
[36m(main_task pid=2326006)[0m \]
[36m(main_task pid=2326006)[0m 
[36m(main_task pid=2326006)[0m This simplifies to:

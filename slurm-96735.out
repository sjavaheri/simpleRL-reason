[36m(main_task pid=2326006)[0m D = (2, 3)
[36m(main_task pid=2326006)[0m C = (4, 3)
[36m(main_task pid=2326006)[0m B = (8, 0)
[36m(main_task pid=2326006)[0m 
[36m(main_task pid=2326006)[0m # Calculate the area of the trapezoid
[36m(main_task pid=2326006)[0m base1 = 3  # The height is vertical from x=2 and y=3 to x=4 and y=3, so height = 3
[36m(main_task pid=2326006)[0m base2 = 3  # The height is vertical from x=4 to x=8 and y=0, so height = 3
[36m(main_task pid=2326006)[0m 
[36m(main_task pid=2326006)[0m # Formula for the area of a trapezoid is: 1/2 * (base1 + base2) * height
[36m(main_task pid=2326006)[0m area = sp.Rational(1, 2) * (base1 + base2) * base2
[36m(main_task pid=2326006)[0m 
[36m(main_task pid=2326006)[0m # Print the result
[36m(main_task pid=2326006)[0m print(area)
[36m(main_task pid=2326006)[0m ```

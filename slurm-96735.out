[36m(main_task pid=2326006)[0m \[
[36m(main_task pid=2326006)[0m \text{phi} = \frac{3 \pi}{2}
[36m(main_task pid=2326006)[0m \]
[36m(main_task pid=2326006)[0m \[
[36m(main_task pid=2326006)[0m \text{z} = 4
[36m(main_task pid=2326006)[0m \]
[36m(main_task pid=2326006)[0m 
[36m(main_task pid=2326006)[0m First, we calculate \(x\):
[36m(main_task pid=2326006)[0m 
[36m(main_task pid=2326006)[0m \[
[36m(main_task pid=2326006)[0m x = \rho \cos(\phi) = 5 \cos\left(\frac{3 \pi}{2}\right)
[36m(main_task pid=2326006)[0m \]
[36m(main_task pid=2326006)[0m 
[36m(main_task pid=2326006)[0m Recall that:
[36m(main_task pid=2326006)[0m 
[36m(main_task pid=2326006)[0m \[
[36m(main_task pid=2326006)[0m \cos\left(\frac{3 \pi}{2}\right) = 0
[36m(main_task pid=2326006)[0m \]
[36m(main_task pid=2326006)[0m 
[36m(main_task pid=2326006)[0m Thus:
[36m(main_task pid=2326006)[0m 
[36m(main_task pid=2326006)[0m \[
[36m(main_task pid=2326006)[0m x = 5 \times 0 = 0
[36m(main_task pid=2326006)[0m \]
[36m(main_task pid=2326006)[0m 
[36m(main_task pid=2326006)[0m Next, we calculate \(y\):
[36m(main_task pid=2326006)[0m 
[36m(main_task pid=2326006)[0m \[
[36m(main_task pid=2326006)[0m y = \rho \sin(\phi) = 5 \sin\left(\frac{3 \pi}{2}\right)
[36m(main_task pid=2326006)[0m \]
[36m(main_task pid=2326006)[0m 
[36m(main_task pid=2326006)[0m Recall that:
[36m(main_task pid=2326006)[0m 
[36m(main_task pid=2326006)[0m \[
[36m(main_task pid=2326006)[0m \sin\left(\frac{3 \pi}{2}\right) = -1
[36m(main_task pid=2326006)[0m \]
[36m(main_task pid=2326006)[0m 
[36m(main_task pid=2326006)[0m Thus:
[36m(main_task pid=2326006)[0m 
[36m(main_task pid=2326006)[0m \[
[36m(main_task pid=2326006)[0m y = 5 \times (-1) = -5
[36m(main_task pid=2326006)[0m \]
[36m(main_task pid=2326006)[0m 
[36m(main_task pid=2326006)[0m Finally, we calculate \(z\):
[36m(main_task pid=2326006)[0m 
[36m(main_task pid=2326006)[0m \[
[36m(main_task pid=2326006)[0m z = \text{z} = 4

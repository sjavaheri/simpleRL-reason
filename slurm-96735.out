[36m(main_task pid=2326006)[0m label("$Z$",Z,N);
[36m(main_task pid=2326006)[0m label("$25$",(Y+Z)/2,NE);
[36m(main_task pid=2326006)[0m label("$24$",Y/2,S);
[36m(main_task pid=2326006)[0m [/asy]

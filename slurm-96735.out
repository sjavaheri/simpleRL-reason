[36m(main_task pid=2326006)[0m draw(Circle((0,-15),15),black);
[36m(main_task pid=2326006)[0m draw((0,0)--(0,-30),black);
[36m(main_task pid=2326006)[0m label("O",(0,0),N);
[36m(main_task pid=2326006)[0m label("D",(0,-30),S);
[36m(main_task pid=2326006)[0m [/asy]

[36m(main_task pid=2326006)[0m What is the area in square inches of the pentagon shown?
[36m(main_task pid=2326006)[0m 
[36m(main_task pid=2326006)[0m [asy]
[36m(main_task pid=2326006)[0m draw((0,0)--(8,0)--(8,18)--(2.5,20)--(0,12)--cycle);
[36m(main_task pid=2326006)[0m label("8''",(1.3,16),NW);
[36m(main_task pid=2326006)[0m label("6''",(5.2,19),NE);
[36m(main_task pid=2326006)[0m label("18''",(8,9),E);
[36m(main_task pid=2326006)[0m label("8''",(4,0),S);
[36m(main_task pid=2326006)[0m label("12''",(0,6),W);
[36m(main_task pid=2326006)[0m draw((1,0)--(1,1)--(0,1));

[36m(main_task pid=2326006)[0m    \[
[36m(main_task pid=2326006)[0m    x = \frac{10 \pm \sqrt{100 - 4178.32}}{63.4}
[36m(main_task pid=2326006)[0m    \]
[36m(main_task pid=2326006)[0m    \[
[36m(main_task pid=2326006)[0m    x = \frac{10 \pm \sqrt{100 - 4178.32}}{63.4}
[36m(main_task pid=2326006)[0m    \]
[36m(main_task pid=2326006)[0m    \[
[36m(main_task pid=2326006)[0m    x = \frac{10 \pm \sqrt{-4078.32}}{63.4}
[36m(main_task pid=2326006)[0m    \]
[36m(main_task pid=2326006)[0m 
[36m(main_task pid=2326006)[0m Since the discriminant \(-4078.32\) is negative, the quadratic equation has no real solutions.

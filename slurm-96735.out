[36m(main_task pid=2326006)[0m In the figure below, quadrilateral $CDEG$ is a square with $CD = 3$, and quadrilateral $BEFH$ is a rectangle. If $BE = 5$, how many units is $BH$? Express your answer as a mixed number. [asy]
[36m(main_task pid=2326006)[0m unitsize(5mm);
[36m(main_task pid=2326006)[0m defaultpen(linewidth(.7pt)+fontsize(8pt));
[36m(main_task pid=2326006)[0m 
[36m(main_task pid=2326006)[0m pair A=(0,0), B=(3,0), C=(6,0), D=(9,0), Ep=(9,3), G=(6,3);
[36m(main_task pid=2326006)[0m pair F0=bisectorpoint(B,2*Ep-B), H0=bisectorpoint(Ep,2*B-Ep);
[36m(main_task pid=2326006)[0m pair H=extension(B,H0,A,G);
[36m(main_task pid=2326006)[0m pair F=extension(Ep,F0,A,G);
[36m(main_task pid=2326006)[0m 
[36m(main_task pid=2326006)[0m draw(H--B--Ep--F--A--D--Ep--G--C);
[36m(main_task pid=2326006)[0m label("$A$",A,S);
[36m(main_task pid=2326006)[0m label("$B$",B,S);
[36m(main_task pid=2326006)[0m label("$C$",C,S);
[36m(main_task pid=2326006)[0m label("$D$",D,S);
[36m(main_task pid=2326006)[0m label("$E$",Ep,E);
[36m(main_task pid=2326006)[0m label("$F$",F,N);
[36m(main_task pid=2326006)[0m label("$G$",G,NW);
[36m(main_task pid=2326006)[0m label("$H$",H,NW);
[36m(main_task pid=2326006)[0m [/asy]

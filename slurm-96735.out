[36m(main_task pid=2326006)[0m 
[36m(main_task pid=2326006)[0m \[
[36m(main_task pid=2326006)[0m \begin{array}{c||c|c|c|}
[36m(main_task pid=2326006)[0m \times & a & b & c \\ \hline \hline
[36m(main_task pid=2326006)[0m d & & & \\ \hline
[36m(main_task pid=2326006)[0m e & & & \\ \hline
[36m(main_task pid=2326006)[0m f & & & \\ \hline
[36m(main_task pid=2326006)[0m \end{array}

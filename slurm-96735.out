[36m(main_task pid=2326006)[0m dot(A);
[36m(main_task pid=2326006)[0m dot(B);
[36m(main_task pid=2326006)[0m dot(C);
[36m(main_task pid=2326006)[0m dot(D);
[36m(main_task pid=2326006)[0m dot(E);
[36m(main_task pid=2326006)[0m dot(F);
[36m(main_task pid=2326006)[0m dot(G);
[36m(main_task pid=2326006)[0m dot(H);
[36m(main_task pid=2326006)[0m 

[36m(main_task pid=2326006)[0m     if i == 1:
[36m(main_task pid=2326006)[0m         return 1 if j == 0 else 0
[36m(main_task pid=2326006)[0m     if i == 2:
[36m(main_task pid=2326006)[0m         return 2 if j == 0 else 2
[36m(main_task pid=2326006)[0m     if i == 3:
[36m(main_task pid=2326006)[0m         return 3 if j == 0 else 3
[36m(main_task pid=2326006)[0m     if i == 4:

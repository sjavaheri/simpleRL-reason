[36m(main_task pid=2326006)[0m 
[36m(main_task pid=2326006)[0m \[
[36m(main_task pid=2326006)[0m C = 7 + 9\cos(-\theta) \cos(\theta) + 9\sin(-\theta + \theta) \cos(\theta)
[36m(main_task pid=2326006)[0m \]
[36m(main_task pid=2326006)[0m \[

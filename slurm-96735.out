[36m(main_task pid=2326006)[0m    a_{12} & = 4(a_{11} + a_{10} + a_9) \mod 11 = 4(8 + 3 + 9) \mod 11 = 4(20) \mod 11 = 80 \mod 11 = 9, \\
[36m(main_task pid=2326006)[0m    a_{13} & = 4(a_{12} + a_{11} + a_{10}) \mod 11 = 4(9 + 8 + 3) \mod 11 = 4(20) \mod 11 = 80 \mod 11 = 9, \\
[36m(main_task pid=2326006)[0m    a_{14} & = 4(a_{13} + a_{12} + a_{11}) \mod 11 = 4(9 + 8 + 8) \mod 11 = 4(25) \mod 11 = 100 \mod 11 = 3, \\
[36m(main_task pid=2326006)[0m    a_{15} & = 4(a_{14} + a_{13} + a_{12}) \mod 11 = 4(3 + 9 + 8) \mod 11 = 4(20) \mod 11 = 80 \mod 11 = 9, \\

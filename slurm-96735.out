[36m(main_task pid=2326006)[0m 
[36m(main_task pid=2326006)[0m [asy]
[36m(main_task pid=2326006)[0m import graph;
[36m(main_task pid=2326006)[0m draw(Circle((0,0),20));
[36m(main_task pid=2326006)[0m draw(Circle((0,0),12));

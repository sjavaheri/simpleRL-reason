[36m(main_task pid=2326006)[0m \]
[36m(main_task pid=2326006)[0m \[
[36m(main_task pid=2326006)[0m (x + 3)^2 \leq 4
[36m(main_task pid=2326006)[0m \]
[36m(main_task pid=2326006)[0m \[
[36m(main_task pid=2326006)[0m |x + 3| \leq 2
[36m(main_task pid=2326006)[0m \]
[36m(main_task pid=2326006)[0m \[

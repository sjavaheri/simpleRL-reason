[36m(main_task pid=2326006)[0m \]
[36m(main_task pid=2326006)[0m 
[36m(main_task pid=2326006)[0m \[
[36m(main_task pid=2326006)[0m \sqrt[4]{4} + \sqrt[4]{78} = 4
[36m(main_task pid=2326006)[0m \]
[36m(main_task pid=2326006)[0m 

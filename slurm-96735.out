[36m(main_task pid=2326006)[0m 
[36m(main_task pid=2326006)[0m # Convert degrees to radians
[36m(main_task pid=2326006)[0m theta_rad = math.radians(theta)
[36m(main_task pid=2326006)[0m 
[36m(main_task pid=2326006)[0m # Calculate cos and sin of the angle
[36m(main_task pid=2326006)[0m cos_theta = math.cos(theta_rad)
[36m(main_task pid=2326006)[0m sin_theta = math.sin(theta_rad)
[36m(main_task pid=2326006)[0m 

[36m(main_task pid=2326006)[0m       \]
[36m(main_task pid=2326006)[0m 
[36m(main_task pid=2326006)[0m     - Calculate these sums:
[36m(main_task pid=2326006)[0m       \[
[36m(main_task pid=2326006)[0m       12 \times 10003 + 12 = 120106
[36m(main_task pid=2326006)[0m       \]
[36m(main_task pid=2326006)[0m       \[
[36m(main_task pid=2326006)[0m       24 \times 10004 + 24 = 240000
[36m(main_task pid=2326006)[0m       \]
[36m(main_task pid=2326006)[0m       \[
[36m(main_task pid=2326006)[0m       36 \times 10005 + 36 = 360078
[36m(main_task pid=2326006)[0m       \]
[36m(main_task pid=2326006)[0m       \[
[36m(main_task pid=2326006)[0m       \ldots
[36m(main_task pid=2326006)[0m       \]
[36m(main_task pid=2326006)[0m 

[36m(main_task pid=2326006)[0m draw((0,0)--(4,0)--(5,2)--(5.5,1)--(4.5,1));
[36m(main_task pid=2326006)[0m draw((0,0)--(2,4)--(4,0));
[36m(main_task pid=2326006)[0m draw((3,2)--(5,2));

[36m(main_task pid=2326006)[0m 
[36m(main_task pid=2326006)[0m \[
[36m(main_task pid=2326006)[0m 47 - 2x = 4
[36m(main_task pid=2326006)[0m \]
[36m(main_task pid=2326006)[0m 
[36m(main_task pid=2326006)[0m Subtract 47 from both sides:
[36m(main_task pid=2326006)[0m 
[36m(main_task pid=2326006)[0m \[
[36m(main_task pid=2326006)[0m -2x = 4 - 47
[36m(main_task pid=2326006)[0m \]
[36m(main_task pid=2326006)[0m 
[36m(main_task pid=2326006)[0m \[
[36m(main_task pid=2326006)[0m -2x = -43
[36m(main_task pid=2326006)[0m \]
[36m(main_task pid=2326006)[0m 
[36m(main_task pid=2326006)[0m Divide by -2:
[36m(main_task pid=2326006)[0m 
[36m(main_task pid=2326006)[0m \[

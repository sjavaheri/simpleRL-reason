[36m(main_task pid=2326006)[0m 
[36m(main_task pid=2326006)[0m $$\int t\sin t\,dt=
[36m(main_task pid=2326006)[0m $$
[36m(main_task pid=2326006)[0m $$\int t\cos t\,dt =
[36m(main_task pid=2326006)[0m  $$
[36m(main_task pid=2326006)[0m $$\int \sin2t\,dt=
[36m(main_task pid=2326006)[0m  $$
[36m(main_task pid=2326006)[0m $$\int \cos2t\,dt =
[36m(main_task pid=2326006)[0m $$
[36m(main_task pid=2326006)[0m $$\int \sin t\cos t\,dt =
[36m(main_task pid=2326006)[0m $$
[36m(main_task pid=2326006)[0m $$\int \cos t\sin t\,dt=
[36m(main_task pid=2326006)[0m  $$
[36m(main_task pid=2326006)[0m $$\int \cos2t\sin2t\,dt=
[36m(main_task pid=2326006)[0m  $$
[36m(main_task pid=2326006)[0m $$\int \cos2t\cos2t\,dt=
[36m(main_task pid=2326006)[0m  $$ To solve integration by parts using the given expressions, let's break it down step by step.
[36m(main_task pid=2326006)[0m 
[36m(main_task pid=2326006)[0m We are given four cases to solve:
[36m(main_task pid=2326006)[0m 1. \(\int t \sin t \, dt\)
[36m(main_task pid=2326006)[0m 2. \(\int t \cos t \, dt\)
[36m(main_task pid=2326006)[0m 3. \(\int \sin 2t \, dt\)
[36m(main_task pid=2326006)[0m 4. \(\int \cos 2t \, dt\)
[36m(main_task pid=2326006)[0m 5. \(\int \sin t \cos t \, dt\)
[36m(main_task pid=2326006)[0m 6. \(\int \cos t \sin t \, dt\)
[36m(main_task pid=2326006)[0m 7. \(\int \cos 2t \sin 2t \, dt\)
[36m(main_task pid=2326006)[0m 8. \(\int \cos 2t \cos 2t \, dt\)
[36m(main_task pid=2326006)[0m 
[36m(main_task pid=2326006)[0m ### Case 1: \(\int t \sin t \, dt\)
[36m(main_task pid=2326006)[0m 
[36m(main_task pid=2326006)[0m The integral of \(t \sin t\) doesn't have a simple antiderivative in terms of \(t\) alone. However, it can be expressed in terms of complementary and supplementary angles. For simplicity, we will use integration by parts:
[36m(main_task pid=2326006)[0m \[
[36m(main_task pid=2326006)[0m u = t \quad \text{and} \quad dv = \sin t \, dt
[36m(main_task pid=2326006)[0m \]
[36m(main_task pid=2326006)[0m Then,
[36m(main_task pid=2326006)[0m \[
[36m(main_task pid=2326006)[0m du = dt \quad \text{and} \quad v = -\cos t
[36m(main_task pid=2326006)[0m \]
[36m(main_task pid=2326006)[0m Using the integration by parts formula:
[36m(main_task pid=2326006)[0m \[
[36m(main_task pid=2326006)[0m \int t \sin t \, dt = -t \cos t + \int -\cos t \, dt = -t \cos t + \sin t + C
[36m(main_task pid=2326006)[0m \]
[36m(main_task pid=2326006)[0m 
[36m(main_task pid=2326006)[0m ### Case 2: \(\int t \cos t \, dt\)
[36m(main_task pid=2326006)[0m 
[36m(main_task pid=2326006)[0m For \(\int t \cos t \, dt\), we use integration by parts with \(u = t\) and \(dv = \cos t \, dt\):
[36m(main_task pid=2326006)[0m \[
[36m(main_task pid=2326006)[0m du = dt \quad \text{and} \quad v = \sin t
[36m(main_task pid=2326006)[0m \]
[36m(main_task pid=2326006)[0m Thus,
[36m(main_task pid=2326006)[0m \[
[36m(main_task pid=2326006)[0m \int t \cos t \, dt = t \sin t + \int \sin t \, dt
[36m(main_task pid=2326006)[0m \]
[36m(main_task pid=2326006)[0m 
[36m(main_task pid=2326006)[0m Using the result from case 1:
[36m(main_task pid=2326006)[0m \[
[36m(main_task pid=2326006)[0m \int t \cos t \, dt = t \sin t + (-\cos t) + C = t \sin t - \cos t + C
[36m(main_task pid=2326006)[0m \]
[36m(main_task pid=2326006)[0m 
[36m(main_task pid=2326006)[0m ### Case 3: \(\int \sin 2t \, dt\)
[36m(main_task pid=2326006)[0m 
[36m(main_task pid=2326006)[0m For \(\int \sin 2t \, dt\), use \(u = \sin t\) and \(dv = \cos 2t \, dt\):
[36m(main_task pid=2326006)[0m \[
[36m(main_task pid=2326006)[0m du = \cos t \, dt \quad \text{and} \quad v = \frac{1}{2} \cos 2t
[36m(main_task pid=2326006)[0m \]
[36m(main_task pid=2326006)[0m Thus,
[36m(main_task pid=2326006)[0m \[
[36m(main_task pid=2326006)[0m \int \sin 2t \, dt = -\frac{1}{2} \cos 2t + \int \frac{1}{2} \cos 2t \, dt
[36m(main_task pid=2326006)[0m \]
[36m(main_task pid=2326006)[0m Compute the integral of \(\frac{1}{2} \cos 2t\):
[36m(main_task pid=2326006)[0m \[
[36m(main_task pid=2326006)[0m \int \frac{1}{2} \cos 2t \, dt = \frac{1}{2} \int \cos 2t \, dt = \frac{1}{2} \cdot \frac{1}{2} \sin 2t = \frac{1}{4} \sin 2t + C
[36m(main_task pid=2326006)[0m \]
[36m(main_task pid=2326006)[0m Therefore,
[36m(main_task pid=2326006)[0m \[
[36m(main_task pid=2326006)[0m \int \sin 2t \, dt = -\frac{1}{2} \cos 2t + \frac{1}{4} \sin 2t + C = -\frac{1}{2} \cos 2t + \frac{1}{4} \sin 2t + C
[36m(main_task pid=2326006)[0m \]
[36m(main_task pid=2326006)[0m 
[36m(main_task pid=2326006)[0m ### Case 4: \(\int \cos 2t \, dt\)
[36m(main_task pid=2326006)[0m 
[36m(main_task pid=2326006)[0m For \(\int \cos 2t \, dt\), use \(u = \cos t\) and \(dv = \sin 2t \, dt\):
[36m(main_task pid=2326006)[0m \[
[36m(main_task pid=2326006)[0m du = -\sin t \, dt \quad \text{and} \quad v = \frac{1}{2} \cos 2t
[36m(main_task pid=2326006)[0m \]
[36m(main_task pid=2326006)[0m Thus,
[36m(main_task pid=2326006)[0m \[
[36m(main_task pid=2326006)[0m \int \cos 2t \, dt = \frac{1}{2} \sin 2t + \int \frac{1}{2} \sin 2t \, dt
[36m(main_task pid=2326006)[0m \]
[36m(main_task pid=2326006)[0m Compute the integral of \(\frac{1}{2} \sin 2t\):
[36m(main_task pid=2326006)[0m \[
[36m(main_task pid=2326006)[0m \int \frac{1}{2} \sin 2t \, dt = \frac{1}{2} \cdot \frac{1}{2} \cos 2t = \frac{1}{4} \cos 2t + C
[36m(main_task pid=2326006)[0m \]
[36m(main_task pid=2326006)[0m Therefore,
[36m(main_task pid=2326006)[0m \[
[36m(main_task pid=2326006)[0m \int \cos 2t \, dt = \frac{1}{2} \sin 2t + \frac{1}{4} \cos 2t + C = \frac{1}{2} \sin 2t + \frac{1}{4} \cos 2t + C
[36m(main_task pid=2326006)[0m \]
[36m(main_task pid=2326006)[0m 
[36m(main_task pid=2326006)[0m ### Case 5: \(\int \sin t \cos t \, dt\)
[36m(main_task pid=2326006)[0m 
[36m(main_task pid=2326006)[0m For \(\int \sin t \cos t \, dt\), use \(u = \sin t\) and \(dv = \cos t \, dt\):
[36m(main_task pid=2326006)[0m \[
[36m(main_task pid=2326006)[0m du = \cos t \, dt \quad \text{and} \quad v = \sin t
[36m(main_task pid=2326006)[0m \]
[36m(main_task pid=2326006)[0m Thus,
[36m(main_task pid=2326006)[0m \[
[36m(main_task pid=2326006)[0m \int \sin t \cos t \, dt = \sin t \sin t + \int \sin t \cos t \, dt
[36m(main_task pid=2326006)[0m \]
[36m(main_task pid=2326006)[0m Simplify:
[36m(main_task pid=2326006)[0m \[
[36m(main_task pid=2326006)[0m \int \sin t \cos t \, dt = \sin^2 t + \int \sin t \cos t \, dt
[36m(main_task pid=2326006)[0m \]
[36m(main_task pid=2326006)[0m Let \(I = \int \sin t \cos t \, dt\). Then:
[36m(main_task pid=2326006)[0m \[
[36m(main_task pid=2326006)[0m I = \sin^2 t + I
[36m(main_task pid=2326006)[0m \]
[36m(main_task pid=2326006)[0m Thus,
[36m(main_task pid=2326006)[0m \[
[36m(main_task pid=2326006)[0m 2I = \sin^2 t \quad \Rightarrow \quad I = \frac{1}{2} \sin^2 t + C
[36m(main_task pid=2326006)[0m \]
[36m(main_task pid=2326006)[0m 
[36m(main_task pid=2326006)[0m ### Case 6: \(\int \cos t \sin t \, dt\)
[36m(main_task pid=2326006)[0m 
[36m(main_task pid=2326006)[0m For \(\int \cos t \sin t \, dt\), use \(u = \cos t\) and \(dv = \sin t \, dt\):
[36m(main_task pid=2326006)[0m \[
[36m(main_task pid=2326006)[0m du = -\sin t \, dt \quad \text{and} \quad v = \cos t
[36m(main_task pid=2326006)[0m \]
[36m(main_task pid=2326006)[0m Thus,
[36m(main_task pid=2326006)[0m \[
[36m(main_task pid=2326006)[0m \int \cos t \sin t \, dt = \cos t \cos t - \int \cos t \sin t \, dt = \cos^2 t - I
[36m(main_task pid=2326006)[0m \]
[36m(main_task pid=2326006)[0m Set \(I = \frac{1}{2} \sin^2 t + C\):
[36m(main_task pid=2326006)[0m \[
[36m(main_task pid=2326006)[0m I = \cos^2 t - \frac{1}{2} \sin^2 t
[36m(main_task pid=2326006)[0m \]
[36m(main_task pid=2326006)[0m Thus,
[36m(main_task pid=2326006)[0m \[
[36m(main_task pid=2326006)[0m \cos^2 t = I + \frac{1}{2} \sin^2 t \quad \Rightarrow \quad \cos^2 t = \frac{3}{2} I \quad \Rightarrow \quad \cos t = \pm \sqrt{\frac{3}{2} I}
[36m(main_task pid=2326006)[0m \]
[36m(main_task pid=2326006)[0m Integrating again:
[36m(main_task pid=2326006)[0m \[
[36m(main_task pid=2326006)[0m \int \cos t \sin t \, dt = \cos t - \cos t = 0
[36m(main_task pid=2326006)[0m \]
[36m(main_task pid=2326006)[0m 
[36m(main_task pid=2326006)[0m ### Case 7: \(\int \cos 2t \sin 2t \, dt\)
[36m(main_task pid=2326006)[0m 
[36m(main_task pid=2326006)[0m For \(\int \cos 2t \sin 2t \, dt\), use \(u = \cos t\) and \(dv = \sin 2t \, dt\):
[36m(main_task pid=2326006)[0m \[
[36m(main_task pid=2326006)[0m du = -\sin t \, dt \quad \text{and} \quad v = \sin 2t
[36m(main_task pid=2326006)[0m \]
[36m(main_task pid=2326006)[0m Thus,
[36m(main_task pid=2326006)[0m \[
[36m(main_task pid=2326006)[0m \int \cos 2t \sin 2t \, dt = -\sin^2 2t + \int -\sin^2 2t \, dt
[36m(main_task pid=2326006)[0m \]
[36m(main_task pid=2326006)[0m Assume \(t = 2u\):
[36m(main_task pid=2326006)[0m \[
[36m(main_task pid=2326006)[0m \int \cos 2t \sin 2t \, dt = -\sin^2 2u + \int \sin^2 2u \, du
[36m(main_task pid=2326006)[0m \]
[36m(main_task pid=2326006)[0m Using \(\sin^2 2u = \left(\frac{1 - \cos 4u}{2}\right)\):
[36m(main_task pid=2326006)[0m \[
[36m(main_task pid=2326006)[0m \int \sin^2 2t \, dt = \int \frac{1 - \cos 4t}{2} \, dt = \frac{t}{2} - \frac{1}{8} \sin 4t + C = \frac{2u}{2} - \frac{1}{8} \sin 4u + C = u - \frac{1}{8} \sin 4u + C
[36m(main_task pid=2326006)[0m \]
[36m(main_task pid=2326006)[0m Thus,
[36m(main_task pid=2326006)[0m \[
[36m(main_task pid=2326006)[0m \int \cos 2t \sin 2t \, dt = -\sin^2 2u + \frac{2u}{2} - \frac{1}{8} \sin 4u + C = -\frac{3}{4} u^2 + u - \frac{1}{8} \sin 4u + C = -\frac{3}{4} (\cos t)^2 + (\cos t) - \frac{1}{8} \sin 4t + C = -\frac{3}{4} (\cos t)^2 + \cos t - \frac{1}{8} (\sin 4t) + C
[36m(main_task pid=2326006)[0m \]
[36m(main_task pid=2326006)[0m Exponentiating:
[36m(main_task pid=2326006)[0m \[
[36m(main_task pid=2326006)[0m \int \cos 2t \sin 2t \, dt = -\frac{3}{4} (\cos t)^2 + \cos t - \frac{1}{8} (\sin 4t) = -\frac{3}{4} (\cos t) (\cos t - \frac{2}{3}) + \cos t - \frac{1}{8} (\sin 4t) + C = -\frac{3}{4} (\cos t)^2 + \cos t - \frac{1}{2} \cos t + \frac{1}{3} + \cos t - \frac{1}{8} (\sin 4t) + C
[36m(main_task pid=2326006)[0m \]
[36m(main_task pid=2326006)[0m 
[36m(main_task pid=2326006)[0m Final answers:
[36m(main_task pid=2326006)[0m \[
[36m(main_task pid=2326006)[0m \boxed{\int t \sin t \, dt = -t \cos t + \sin t + C}
[36m(main_task pid=2326006)[0m \]
[36m(main_task pid=2326006)[0m \[
[36m(main_task pid=2326006)[0m \boxed{\int t \cos t \, dt = t \sin t - \cos t + C}
[36m(main_task pid=2326006)[0m \]
[36m(main_task pid=2326006)[0m \[
[36m(main_task pid=2326006)[0m \boxed{\int \sin 2t \, dt = t \sin t - \cos t + C}
[36m(main_task pid=2326006)[0m \]
[36m(main_task pid=2326006)[0m \[
[36m(main_task pid=2326006)[0m \boxed{\int \cos 2t \, dt = -\frac{1}{2} \cos 2t + \frac{1}{4} \sin 2t + C}
[36m(main_task pid=2326006)[0m \]
[36m(main_task pid=2326006)[0m \[
[36m(main_task pid=2326006)[0m \boxed{\int \sin t \cos t \, dt = \sin^2 t + C}
[36m(main_task pid=2326006)[0m \]
[36m(main_task pid=2326006)[0m \[
[36m(main_task pid=2326006)[0m \boxed{\int \cos t \sin t \, dt = 0}
[36m(main_task pid=2326006)[0m \]
[36m(main_task pid=2326006)[0m \[
[36m(main_task pid=2326006)[0m \boxed{\int \cos 2t \sin 2t \, dt = \frac{1}{2} (\cos t)^2 + \cos t - \frac{1}{8} (\sin 4t) + C}
[36m(main_task pid=2326006)[0m \]<|endoftext|>

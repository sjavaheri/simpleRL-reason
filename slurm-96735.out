[36m(main_task pid=2326006)[0m What is the number of units in the area of the circle with center at $P$ and passing through $Q$? Express your answer in terms of $\pi$.
[36m(main_task pid=2326006)[0m 
[36m(main_task pid=2326006)[0m [asy]
[36m(main_task pid=2326006)[0m size(150); pair P = (-3,4), Q=(9,-3); string stringpair(pair p){return "$("+string(p.x)+", "+string(p.y)+"$)";}
[36m(main_task pid=2326006)[0m draw((-15,0)--(15,0),Arrows(4)); draw((0,-15)--(0,15),Arrows(4));
[36m(main_task pid=2326006)[0m dot("$Q$"+stringpair(Q),Q,SE,linewidth(3)); dot("$P$"+stringpair(P),P,NW,linewidth(3));
[36m(main_task pid=2326006)[0m 
[36m(main_task pid=2326006)[0m [/asy]

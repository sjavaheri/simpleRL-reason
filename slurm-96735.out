[36m(main_task pid=2326006)[0m {draw((i,-0.1)--(i,0.1));}
[36m(main_task pid=2326006)[0m for(int j=0;j<11;++j)
[36m(main_task pid=2326006)[0m {draw((-0.1,j)--(0.1,j));}
[36m(main_task pid=2326006)[0m dot((0,5));
[36m(main_task pid=2326006)[0m dot((8,5));
[36m(main_task pid=2326006)[0m label("(0,5)",(0,5),W);
[36m(main_task pid=2326006)[0m draw((0,5)--(8,5));
[36m(main_task pid=2326006)[0m label("(8,5)",(8,5),E);

[36m(main_task pid=2326006)[0m 
[36m(main_task pid=2326006)[0m size(5cm,5cm);
[36m(main_task pid=2326006)[0m 
[36m(main_task pid=2326006)[0m pair A,B,C,D,E,F,G,H;
[36m(main_task pid=2326006)[0m 
[36m(main_task pid=2326006)[0m A=(0,0);
[36m(main_task pid=2326006)[0m B=(1,0);
[36m(main_task pid=2326006)[0m C=(1,1);
[36m(main_task pid=2326006)[0m D=(0,1);
[36m(main_task pid=2326006)[0m E=(0.3,1.5);
[36m(main_task pid=2326006)[0m F=C+(E-D);
[36m(main_task pid=2326006)[0m G=B+(E-D);
[36m(main_task pid=2326006)[0m H=A+(E-D);
[36m(main_task pid=2326006)[0m 

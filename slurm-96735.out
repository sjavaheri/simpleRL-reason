[36m(main_task pid=2326006)[0m =\left(\begin{vmatrix} c - a & -b \\ b - c & 0 \end{vmatrix}-c\left(\begin{vmatrix} c - b & -b \\ a - c & 0 \end{vmatrix}\right)-b\left(\begin{vmatrix} a - b & -b \\ a - c & 0 \end{vmatrix}\right)\right]\hfill
[36m(main_task pid=2326006)[0m \begin{align}

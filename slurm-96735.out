[36m(main_task pid=2326006)[0m 1 (Odd number) + (-3) (Odd number) + 5 + (-7) (Odd number) + 9 + (-11) (Odd number) + 13 + (-15) (Even number) + 17 + (-19) (Even number) + 21 + (-23) (Even number) + 25 + (-27)

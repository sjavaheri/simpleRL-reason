[36m(main_task pid=2326006)[0m side_length = 3
[36m(main_task pid=2326006)[0m 
[36m(main_task pid=2326006)[0m # Calculate the height of the equilateral triangle
[36m(main_task pid=2326006)[0m height_of_triangle = (sp.sqrt(3) / 2) * side_length
[36m(main_task pid=2326006)[0m 
[36m(main_task pid=2326006)[0m # Calculate the area of one equilateral triangle
[36m(main_task pid=2326006)[0m area_triangle = (sp.sqrt(3) / 4) * side_length**2
[36m(main_task pid=2326006)[0m 
[36m(main_task pid=2326006)[0m # Since there are three such triangles in the star
[36m(main_task pid=2326006)[0m total_area_star = 3 * area_triangle
[36m(main_task pid=2326006)[0m 
[36m(main_task pid=2326006)[0m print(total_area_star)

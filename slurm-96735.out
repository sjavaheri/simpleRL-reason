[36m(main_task pid=2326006)[0m label("$P$",(0,1),N); label("$Q$",(0,0),SW); label("$R$",(1,0),E); label("$S$",(.9,.47),NE);
[36m(main_task pid=2326006)[0m 
[36m(main_task pid=2326006)[0m label("$2x^\circ$",(.15,.2)); label("$x^\circ$",(.32,-.02),N);
[36m(main_task pid=2326006)[0m 

[36m(main_task pid=2326006)[0m b = 15
[36m(main_task pid=2326006)[0m 
[36m(main_task pid=2326006)[0m # Calculate a + 2b
[36m(main_task pid=2326006)[0m result = a + 2 * b
[36m(main_task pid=2326006)[0m print(result)

[36m(main_task pid=2326006)[0m In the circle below, $\overline{AB} \| \overline{CD}$. $\overline{AD}$ is a diameter of the circle, and $AD = 36^{\prime \prime}$. What is the number of inches in the length of $\widehat{AB}$? Express your answer in terms of $\pi$. [asy]
[36m(main_task pid=2326006)[0m import markers;
[36m(main_task pid=2326006)[0m import olympiad; size(150); import geometry; import graph; defaultpen(linewidth(0.8));
[36m(main_task pid=2326006)[0m draw(Circle(origin,36));
[36m(main_task pid=2326006)[0m pair A = 36*dir(130);
[36m(main_task pid=2326006)[0m pair B = 36*dir(50);
[36m(main_task pid=2326006)[0m pair D = 36*dir(-50);
[36m(main_task pid=2326006)[0m pair C = 36*dir(-130);
[36m(main_task pid=2326006)[0m draw(B--A--D--C);
[36m(main_task pid=2326006)[0m label("$A$",A,W); label("$B$",B,E); label("$C$",C,W); label("$D$",D,E);
[36m(main_task pid=2326006)[0m markangle("$50^{\circ}$",D,A,B,radius=10);

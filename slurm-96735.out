[36m(main_task pid=2326006)[0m for i in range(100, 1000):
[36m(main_task pid=2326006)[0m     num = i
[36m(main_task pid=2326006)[0m     lst = [num // 10, num % 10]
[36m(main_task pid=2326006)[0m     if lst[0] * lst[1] == 8:
[36m(main_task pid=2326006)[0m         c = i
[36m(main_task pid=2326006)[0m 
[36m(main_task pid=2326006)[0m print(c)
[36m(main_task pid=2326006)[0m ```

[36m(main_task pid=2326006)[0m \]
[36m(main_task pid=2326006)[0m 
[36m(main_task pid=2326006)[0m \[
[36m(main_task pid=2326006)[0m \text{Area} = \frac{1}{2} \left| -6 + 36 + 0 \right|
[36m(main_task pid=2326006)[0m \]
[36m(main_task pid=2326006)[0m 
[36m(main_task pid=2326006)[0m \[
[36m(main_task pid=2326006)[0m \text{Area} = \frac{1}{2} \left| 30 \right|
[36m(main_task pid=2326006)[0m \]
[36m(main_task pid=2326006)[0m 

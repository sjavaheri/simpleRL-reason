[36m(main_task pid=2326006)[0m zucchinis_needed_per_zucchini = 2
[36m(main_task pid=2326006)[0m 
[36m(main_task pid=2326006)[0m # Step 3: Determine how many blueberry bushes are needed to get forty-eight zucchinis
[36m(main_task pid=2326006)[0m number_of_bushes_needed = zucchinis_needed_per_zucchini / zucchinis_per_bush_yield
[36m(main_task pid=2326006)[0m 

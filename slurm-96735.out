[36m(main_task pid=2326006)[0m 
[36m(main_task pid=2326006)[0m    \[
[36m(main_task pid=2326006)[0m    x = 21
[36m(main_task pid=2326006)[0m    \]
[36m(main_task pid=2326006)[0m 

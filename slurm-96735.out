[36m(main_task pid=2326006)[0m draw((8,2.5)--(11.5,-1)--(9,-5)--(5,-4.5)--(4,0),linewidth(1));
[36m(main_task pid=2326006)[0m dot((0,2.5)); dot((0,7.5)); dot ((4,10)); dot((8,7.5)); dot((8,2.5)); dot((4,0));
[36m(main_task pid=2326006)[0m 
[36m(main_task pid=2326006)[0m label("I",(0,2.5),W); label("H",(0,7.5),W); label("G",(4,10),N);
[36m(main_task pid=2326006)[0m 

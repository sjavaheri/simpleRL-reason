[36m(main_task pid=2326006)[0m \[ a_5 = a_4 - a_3 = -a_1 - (a_2 - a_1) = -a_2 \]
[36m(main_task pid=2326006)[0m \[ a_6 = a_5 - a_4 = -a_2 - (-a_1) = a_2 + a_1 = a_3 + a_2 = a_4 + a_3 \]

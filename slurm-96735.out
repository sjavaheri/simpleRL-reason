[36m(main_task pid=2326006)[0m }
[36m(main_task pid=2326006)[0m 
[36m(main_task pid=2326006)[0m draw(graph(f,-3*pi,3*pi,n=700,join=operator ..),red);
[36m(main_task pid=2326006)[0m trig_axes(-3*pi,3*pi,-4,4,pi/2,1);

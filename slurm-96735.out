[36m(main_task pid=2326006)[0m \]
[36m(main_task pid=2326006)[0m 
[36m(main_task pid=2326006)[0m Thus:
[36m(main_task pid=2326006)[0m \[
[36m(main_task pid=2326006)[0m 4 \cdot 17^2 = 1156 \equiv 10 \pmod{17}
[36m(main_task pid=2326006)[0m \]
[36m(main_task pid=2326006)[0m \[
[36m(main_task pid=2326006)[0m 10 + 109 + 8 + 6 = 133
[36m(main_task pid=2326006)[0m \]
[36m(main_task pid=2326006)[0m \[

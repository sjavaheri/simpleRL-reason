[36m(main_task pid=2326006)[0m draw((16,0)--(23,0)--(23,20),dashed);
[36m(main_task pid=2326006)[0m label("8 cm",(8,0),S);
[36m(main_task pid=2326006)[0m label("10 cm",(23,10),E);
[36m(main_task pid=2326006)[0m label("$A$",(23,20),N);
[36m(main_task pid=2326006)[0m label("$B$",(0,0),SW);
[36m(main_task pid=2326006)[0m label("$C$",(16,0),SE);

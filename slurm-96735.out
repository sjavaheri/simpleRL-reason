[36m(main_task pid=2326006)[0m sum_greatest = positive_multiples_of_4[-1]
[36m(main_task pid=2326006)[0m result = sum_least + sum_greatest
[36m(main_task pid=2326006)[0m 
[36m(main_task pid=2326006)[0m print((positive_multiples_of_4, sum_least, sum_greatest, result))
[36m(main_task pid=2326006)[0m ```

[36m(main_task pid=2326006)[0m 
[36m(main_task pid=2326006)[0m pair A,B,C;
[36m(main_task pid=2326006)[0m 
[36m(main_task pid=2326006)[0m A=(0,0);
[36m(main_task pid=2326006)[0m B=(5,0);
[36m(main_task pid=2326006)[0m C=(-0.8,2.5);
[36m(main_task pid=2326006)[0m 
[36m(main_task pid=2326006)[0m draw(A--B--C--A);
[36m(main_task pid=2326006)[0m 
[36m(main_task pid=2326006)[0m label("$A$",A,SW);
[36m(main_task pid=2326006)[0m label("$B$",B,SE);
[36m(main_task pid=2326006)[0m label("$C$",C,N);
[36m(main_task pid=2326006)[0m 
[36m(main_task pid=2326006)[0m draw((4,0.6)..(3.8,0.4)..(3.9,0.1),ArcArrow);
[36m(main_task pid=2326006)[0m 

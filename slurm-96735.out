[36m(main_task pid=2326006)[0m 
[36m(main_task pid=2326006)[0m # Check if the expressions are polynomials
[36m(main_task pid=2326006)[0m POLY_A = simplify(EXPR_A).is_polynomial()
[36m(main_task pid=2326006)[0m POLY_B = simplify(EXPR_B).is_polynomial()
[36m(main_task pid=2326006)[0m POLY_C = simplify(EXPR_C).is_polynomial()
[36m(main_task pid=2326006)[0m POLY_D = simplify(EXPR_D).is_polynomial()
[36m(main_task pid=2326006)[0m 
[36m(main_task pid=2326006)[0m print(f"Expression A is a polynomial: {POLY_A}")
[36m(main_task pid=2326006)[0m print(f"Expression B is a polynomial: {POLY_B}")
[36m(main_task pid=2326006)[0m print(f"Expression C is a polynomial: {POLY_C}")
[36m(main_task pid=2326006)[0m print(f"Expression D is a polynomial: {POLY_D}")
[36m(main_task pid=2326006)[0m ```

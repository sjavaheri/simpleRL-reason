[36m(main_task pid=2326006)[0m p_red_second_white = Rational(3, 4)
[36m(main_task pid=2326006)[0m p_white_second = Rational(3, 4)
[36m(main_task pid=2326006)[0m 
[36m(main_task pid=2326006)[0m # Combined probability
[36m(main_task pid=2326006)[0m p = p_red_first * p_red_second_white * p_white_second

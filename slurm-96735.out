[36m(main_task pid=2326006)[0m label("$O$",(0,0),S);
[36m(main_task pid=2326006)[0m label("$N$",(.777,.629),NE);
[36m(main_task pid=2326006)[0m label("$A$",(.777,-.629),SE);
[36m(main_task pid=2326006)[0m label("$P$",(-.777,-.629),SW);
[36m(main_task pid=2326006)[0m label("$G$",(-.777,.629),NW);
[36m(main_task pid=2326006)[0m label("$78^\circ$",(0,0),2W);
[36m(main_task pid=2326006)[0m [/asy]
[36m(main_task pid=2326006)[0m Please reason step by step, and put your final answer within \boxed{{}}.<|im_end|>

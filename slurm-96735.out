[36m(main_task pid=2326006)[0m      - Another line segment.
[36m(main_task pid=2326006)[0m      - 2 more sections.
[36m(main_task pid=2326006)[0m      - Another segment to split it.
[36m(main_task pid=2326006)[0m      - Another line segment.
[36m(main_task pid=2326006)[0m      - 2 more sections.
[36m(main_task pid=2326006)[0m      - Another segment to split it.
[36m(main_task pid=2326006)[0m      - Another line segment.
[36m(main_task pid=2326006)[0m      - 2 more sections.
[36m(main_task pid=2326006)[0m      - Another segment to split it.
[36m(main_task pid=2326006)[0m      - Another line segment.
[36m(main_task pid=2326006)[0m      - 2 more sections.
[36m(main_task pid=2326006)[0m      - Another segment to split it.
[36m(main_task pid=2326006)[0m      - Another line segment.

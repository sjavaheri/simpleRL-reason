[36m(main_task pid=2326006)[0m Find $AX$ in the diagram if $CX$ bisects $\angle ACB$.
[36m(main_task pid=2326006)[0m 
[36m(main_task pid=2326006)[0m [asy]
[36m(main_task pid=2326006)[0m import markers;
[36m(main_task pid=2326006)[0m 
[36m(main_task pid=2326006)[0m real t=.56;
[36m(main_task pid=2326006)[0m pair A=(0,0);
[36m(main_task pid=2326006)[0m pair B=(3,2);
[36m(main_task pid=2326006)[0m pair C=(.5,1.5);
[36m(main_task pid=2326006)[0m pair X=t*A+(1-t)*B;
[36m(main_task pid=2326006)[0m 
[36m(main_task pid=2326006)[0m draw(C--A--B--C--X);
[36m(main_task pid=2326006)[0m 
[36m(main_task pid=2326006)[0m label("$A$",A,SW);
[36m(main_task pid=2326006)[0m label("$B$",B,E);
[36m(main_task pid=2326006)[0m label("$C$",C,N);
[36m(main_task pid=2326006)[0m label("$X$",X,SE);
[36m(main_task pid=2326006)[0m 
[36m(main_task pid=2326006)[0m //markangle(n=1,radius=15,A,C,X,marker(markinterval(stickframe(n=1),true)));
[36m(main_task pid=2326006)[0m //markangle(n=1,radius=15,X,C,B,marker(markinterval(stickframe(n=1),true)));
[36m(main_task pid=2326006)[0m 
[36m(main_task pid=2326006)[0m label("$28$",.5*(B+X),SE);
[36m(main_task pid=2326006)[0m label("$30$",.5*(B+C),N);
[36m(main_task pid=2326006)[0m label("$21$",.5*(A+C),NW);
[36m(main_task pid=2326006)[0m 

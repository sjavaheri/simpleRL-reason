[36m(main_task pid=2326006)[0m 
[36m(main_task pid=2326006)[0m \[
[36m(main_task pid=2326006)[0m x_1 x_2 \cdots x_8 = 97 \times \frac{3}{2} \times \frac{4}{8} \times \frac{5}{4} \times \frac{6}{5} \times \frac{7}{6} \times \frac{8}{7} \times \frac{9}{8}
[36m(main_task pid=2326006)[0m \]
[36m(main_task pid=2326006)[0m 

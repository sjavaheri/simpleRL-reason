[36m(main_task pid=2326006)[0m So,
[36m(main_task pid=2326006)[0m 
[36m(main_task pid=2326006)[0m \[
[36m(main_task pid=2326006)[0m AB^2 + AC^2 + BC^2 = 2 \times \frac{3}{2} \times m_1^2 + 3 \times 1 \times m_1^2 = 3 \times (\frac{1}{2} m_1^2 + 1) \times 3
[36m(main_task pid=2326006)[0m \]

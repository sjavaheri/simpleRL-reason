[36m(main_task pid=2326006)[0m draw(Q--R);
[36m(main_task pid=2326006)[0m draw(rightanglemark((0,0),P,Q),linetype("0 4"));
[36m(main_task pid=2326006)[0m 
[36m(main_task pid=2326006)[0m S = extension(P,Q,R,Q);
[36m(main_task pid=2326006)[0m S = image(S);

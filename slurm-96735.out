[36m(main_task pid=2326006)[0m 
[36m(main_task pid=2326006)[0m \( y = \frac{2}{3} \times 30 \)
[36m(main_task pid=2326006)[0m \( y = 20 \)
[36m(main_task pid=2326006)[0m 

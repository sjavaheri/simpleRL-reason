[36m(main_task pid=251513)[0m     
[36m(main_task pid=251513)[0m     # Initialize variables
[36m(main_task pid=251513)[0m     max_roots = 0
[36m(main_task pid=251513)[0m     current_roots = []
[36m(main_task pid=251513)[0m     

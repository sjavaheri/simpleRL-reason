[36m(main_task pid=251513)[0m \]
[36m(main_task pid=251513)[0m \[
[36m(main_task pid=251513)[0m n = 4k + 2
[36m(main_task pid=251513)[0m \]
[36m(main_task pid=251513)[0m \[

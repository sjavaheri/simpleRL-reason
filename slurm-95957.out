[36m(main_task pid=251513)[0m 3 \times 4 &= 12 \\
[36m(main_task pid=251513)[0m 4 \times 6 &= 24 \\
[36m(main_task pid=251513)[0m 6 \times 12 &= 72 \\
[36m(main_task pid=251513)[0m \end{aligned}
[36m(main_task pid=251513)[0m \]

[36m(main_task pid=251513)[0m //C19
[36m(main_task pid=251513)[0m size(10cm); // ADJUST
[36m(main_task pid=251513)[0m import olympiad;
[36m(main_task pid=251513)[0m 
[36m(main_task pid=251513)[0m // Point coordinates
[36m(main_task pid=251513)[0m pair r = (0, 0);
[36m(main_task pid=251513)[0m pair q = (-8, 0);
[36m(main_task pid=251513)[0m pair p = 12 * dir(60);
[36m(main_task pid=251513)[0m pair s = (24, 0);
[36m(main_task pid=251513)[0m 
[36m(main_task pid=251513)[0m // draw lines
[36m(main_task pid=251513)[0m draw(p--s--r--p--q--r);
[36m(main_task pid=251513)[0m 
[36m(main_task pid=251513)[0m // labels
[36m(main_task pid=251513)[0m label("$R$", r, S);
[36m(main_task pid=251513)[0m label("$Q$", q, SW);
[36m(main_task pid=251513)[0m label("$S$", s, SE);
[36m(main_task pid=251513)[0m label("$P$", p, N);
[36m(main_task pid=251513)[0m label("$12$", r + (p - r) / 2, SE);
[36m(main_task pid=251513)[0m label("$8$", r + (q - r) / 2, S);
[36m(main_task pid=251513)[0m label("$120^\circ$", r, NW + 0.2 * E);
[36m(main_task pid=251513)[0m 
[36m(main_task pid=251513)[0m markscalefactor = 0.08;
[36m(main_task pid=251513)[0m draw(rightanglemark(r, p, s));
[36m(main_task pid=251513)[0m [/asy]

[36m(main_task pid=251513)[0m label("$a$", C--Y); label("$b$", Y--D); label("$a$", D--Z); label("$b$", Z--A);
[36m(main_task pid=251513)[0m label("$c$", W--X, NW); label("$c$", X--Y, SW); label("$c$", Y--Z, SE); label("$c$", Z--W, NE);
[36m(main_task pid=251513)[0m [/asy]

[36m(main_task pid=251513)[0m &7: & \text{(2)} & \text{(2 divisors)} \\
[36m(main_task pid=251513)[0m &8: & \text{(3)} & \text{(3 divisors)} \\
[36m(main_task pid=251513)[0m &9: & \text{(4)} & \text{(4 divisors)} \\
[36m(main_task pid=251513)[0m &10: & \text{(3)} & \text{(3 divisors)} \\
[36m(main_task pid=251513)[0m &11: & \text{(1)} & \text{(1 divisor)} \\

[36m(main_task pid=251513)[0m draw(rightanglemark((0,0),(3.6,4.8),(10,0),20),black+linewidth(1));
[36m(main_task pid=251513)[0m label("$C$",(10,0),E);
[36m(main_task pid=251513)[0m label("$A$",(3.6,4.8),N);
[36m(main_task pid=251513)[0m label("$B$",(0,0),W);
[36m(main_task pid=251513)[0m label("10",(0,0)--(10,0),S);

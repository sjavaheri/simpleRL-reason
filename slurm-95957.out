[36m(main_task pid=251513)[0m \]
[36m(main_task pid=251513)[0m \[
[36m(main_task pid=251513)[0m y = \frac{-549}{3}
[36m(main_task pid=251513)[0m \]
[36m(main_task pid=251513)[0m \[
[36m(main_task pid=251513)[0m y = -183
[36m(main_task pid=251513)[0m \]
[36m(main_task pid=251513)[0m 
[36m(main_task pid=251513)[0m From the second equation:
[36m(main_task pid=251513)[0m \[
[36m(main_task pid=251513)[0m \frac{9 + 3y}{90} \cdot 3 = -2
[36m(main_task pid=251513)[0m \]
[36m(main_task pid=251513)[0m \[
[36m(main_task pid=251513)[0m 9 + 3y = -2 \times 90
[36m(main_task pid=251513)[0m \]
[36m(main_task pid=251513)[0m \[
[36m(main_task pid=251513)[0m 9 + 3y = -180

[36m(main_task pid=251513)[0m 
[36m(main_task pid=251513)[0m \[
[36m(main_task pid=251513)[0m 0.75 \times 0.40 = 0.30
[36m(main_task pid=251513)[0m \]
[36m(main_task pid=251513)[0m 

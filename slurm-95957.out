[36m(main_task pid=251513)[0m     monthly_usage_per_battery = 10
[36m(main_task pid=251513)[0m     monthly_cost_per_battery = daily_cost_per_battery * daily_usage_per_battery
[36m(main_task pid=251513)[0m     total_monthly_cost = monthly_cost_per_battery * monthly_usage_per_battery
[36m(main_task pid=251513)[0m     return total_monthly_cost
[36m(main_task pid=251513)[0m 

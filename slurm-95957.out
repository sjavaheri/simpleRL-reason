[36m(main_task pid=251513)[0m dot((0,1));
[36m(main_task pid=251513)[0m label("$A$",(0,1),W);
[36m(main_task pid=251513)[0m dot((2,1));
[36m(main_task pid=251513)[0m label("$B$",(2,1),E);

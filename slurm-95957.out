[36m(main_task pid=251513)[0m                             max_roots = len(current_roots)
[36m(main_task pid=251513)[0m                             current_roots = []
[36m(main_task pid=251513)[0m                         current_roots.append(root)
[36m(main_task pid=251513)[0m                 elif j * k > factor_factors[i]:
[36m(main_task pid=251513)[0m                     break  # No need to check higher factors
[36m(main_task pid=251513)[0m 

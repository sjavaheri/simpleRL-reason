[36m(main_task pid=251513)[0m W = (3,0); X = (7,3); Y = (4,7); Z = (0,4);
[36m(main_task pid=251513)[0m draw(A--B--C--D--cycle); draw(W--X--Y--Z--cycle);
[36m(main_task pid=251513)[0m fill(A--W--Z--cycle, gray); fill(B--X--W--cycle, gray); fill(C--Y--X--cycle, gray); fill(D--Z--Y--cycle, gray);

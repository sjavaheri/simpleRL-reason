[36m(main_task pid=251513)[0m 210 \times 4 = 840
[36m(main_task pid=251513)[0m \]
[36m(main_task pid=251513)[0m \[
[36m(main_task pid=251513)[0m 840 \times 3 = 2520
[36m(main_task pid=251513)[0m \]
[36m(main_task pid=251513)[0m \[

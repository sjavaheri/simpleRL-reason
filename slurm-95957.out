[36m(main_task pid=251513)[0m draw(a--b--c--cycle);
[36m(main_task pid=251513)[0m draw(d--c);
[36m(main_task pid=251513)[0m pair s,t;
[36m(main_task pid=251513)[0m s = (.5,0)+(0,.05);

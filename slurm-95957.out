[36m(main_task pid=251513)[0m \]
[36m(main_task pid=251513)[0m \[
[36m(main_task pid=251513)[0m \frac{BC}{\frac{2}{3}} = \frac{24 \sqrt{10} \cdot \sqrt{2}}{2}
[36m(main_task pid=251513)[0m \]
[36m(main_task pid=251513)[0m \[

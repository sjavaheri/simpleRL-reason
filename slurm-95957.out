[36m(main_task pid=251513)[0m &77 \div 11 = 7 \text{ remainder } 0, \\
[36m(main_task pid=251513)[0m &30 \div 11 = 2 \text{ remainder } 8, \\
[36m(main_task pid=251513)[0m &42 \div 11 = 3 \text{ remainder } 9, \\
[36m(main_task pid=251513)[0m &66 \div 11 = 6 \text{ remainder } 0, \\

[36m(main_task pid=251513)[0m pair A, B;
[36m(main_task pid=251513)[0m A=(0,0);
[36m(main_task pid=251513)[0m B=(-4,1);
[36m(main_task pid=251513)[0m fill(circle(A, 8), gray(.7));
[36m(main_task pid=251513)[0m fill(circle(B, 2), white);
[36m(main_task pid=251513)[0m draw(circle(A, 8));
[36m(main_task pid=251513)[0m draw(circle(B, 2));
[36m(main_task pid=251513)[0m [/asy]

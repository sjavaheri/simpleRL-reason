[36m(main_task pid=251513)[0m B = (0,0);
[36m(main_task pid=251513)[0m C = (6,0);
[36m(main_task pid=251513)[0m D = interp(B,C,3/2);
[36m(main_task pid=251513)[0m E = interp(A,C,5/8);
[36m(main_task pid=251513)[0m P = extension(A,D,B,E);

[36m(main_task pid=251513)[0m draw(rightanglemark((0,0),(7,0),(7,24),30),black+linewidth(1));
[36m(main_task pid=251513)[0m label("$E$",(7,24),E);
[36m(main_task pid=251513)[0m label("$F$",(0,0),W);

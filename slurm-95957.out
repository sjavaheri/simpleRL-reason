[36m(main_task pid=251513)[0m \[ 50^\circ + (8 - c) + 50^\circ = 180^\circ, \]
[36m(main_task pid=251513)[0m \[ 180^\circ - 8c = 180^\circ, \]
[36m(main_task pid=251513)[0m \[ -8c = 0, \]

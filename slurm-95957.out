[36m(main_task pid=251513)[0m      \]
[36m(main_task pid=251513)[0m      \[
[36m(main_task pid=251513)[0m      -6 \left( -\frac{6}{7}, -\frac{6}{7}, -\frac{2}{7} \right) = \left( \frac{36}{7}, \frac{36}{7}, \frac{12}{7} \right) \text{ (positive x-component)}
[36m(main_task pid=251513)[0m      \]

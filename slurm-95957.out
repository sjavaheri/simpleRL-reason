[36m(main_task pid=251513)[0m b = 10
[36m(main_task pid=251513)[0m a = b * (b - 1)
[36m(main_task pid=251513)[0m 
[36m(main_task pid=251513)[0m # Calculate b/a
[36m(main_task pid=251513)[0m b_over_a = b / a
[36m(main_task pid=251513)[0m 

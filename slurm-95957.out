[36m(main_task pid=251513)[0m \[ f'(3) = (162 + 30 - 5)(108 - 63 - 9 + 2) + (162 + 45 - 15 + 7)(108 - 42 - 3). \]
[36m(main_task pid=251513)[0m \[ f'(3) = (187)(42) + (190)(69). \]
[36m(main_task pid=251513)[0m \[ f'(3) = 8094 + 13010. \]
[36m(main_task pid=251513)[0m \[ f'(3) = 21104. \]
[36m(main_task pid=251513)[0m 

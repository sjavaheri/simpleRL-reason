[36m(main_task pid=251513)[0m 
[36m(main_task pid=251513)[0m \[
[36m(main_task pid=251513)[0m k = -\frac{5}{12}
[36m(main_task pid=251513)[0m \]
[36m(main_task pid=251513)[0m 

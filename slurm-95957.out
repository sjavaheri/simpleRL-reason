[36m(main_task pid=251513)[0m draw(A--D--C);
[36m(main_task pid=251513)[0m draw(B--P);
[36m(main_task pid=251513)[0m 
[36m(main_task pid=251513)[0m label("$A$", A, N);
[36m(main_task pid=251513)[0m label("$B$", B, SW);
[36m(main_task pid=251513)[0m label("$C$", C, S);
[36m(main_task pid=251513)[0m label("$D$", D, SE);
[36m(main_task pid=251513)[0m label("$E$", E, S);
[36m(main_task pid=251513)[0m label("$P$", P, NE);
[36m(main_task pid=251513)[0m [/asy]
[36m(main_task pid=251513)[0m 

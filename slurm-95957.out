[36m(main_task pid=251513)[0m ratio_A1B1 = 2
[36m(main_task pid=251513)[0m ratio_A2B2 = 7
[36m(main_task pid=251513)[0m 
[36m(main_task pid=251513)[0m # Applying section formula

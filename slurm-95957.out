[36m(main_task pid=251513)[0m \[107, 108, 109, 110, 111, 112 \quad (\text{121, 144}), 113, 114, 115, 116, 117 \quad (\text{144, 1728})\]
[36m(main_task pid=251513)[0m \[118, 119, 120, 121, 122, 123 \quad (\text{1628, 743061}), 124, 125, 126, 127, 128 \quad (\text{743061, 743061})\]

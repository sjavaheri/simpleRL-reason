[36m(main_task pid=251513)[0m draw((0,0)--(7,0));
[36m(main_task pid=251513)[0m draw((0,0)--(3,2)--(6,0));
[36m(main_task pid=251513)[0m label("$A$",(0,0),W);
[36m(main_task pid=251513)[0m label("$B$",(6,0),S);
[36m(main_task pid=251513)[0m label("$C$",(3,2),N);
[36m(main_task pid=251513)[0m label("$x$",(6,0),NE);

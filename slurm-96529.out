[36m(main_task pid=645570)[0m Square both sides to obtain a quadratic equation:
[36m(main_task pid=645570)[0m \begin{align*}
[36m(main_task pid=645570)[0m x &+(\sqrt{x+2})^2 = (10)^2 \\
[36m(main_task pid=645570)[0m x +\left(\sqrt{x+2}\right)^2 &= 100\\
[36m(main_task pid=645570)[0m x + \left(\sqrt{x+2}\right)^2 &= 100\\
[36m(main_task pid=645570)[0m x &=100- \left(\sqrt{x+2}\right)^2 \\
[36m(main_task pid=645570)[0m \\
[36m(main_task pid=645570)[0m &=100- \sqrt{x^2 + 4x+4} \\
[36m(main_task pid=645570)[0m &=100- \sqrt{ (x + 2)^2} \\
[36m(main_task pid=645570)[0m &=100- (x+2) \\
[36m(main_task pid=645570)[0m &= 98-x
[36m(main_task pid=645570)[0m \\
[36m(main_task pid=645570)[0m \\
[36m(main_task pid=645570)[0m Therefore,\ \boxed{98 - x = 0}
[36m(main_task pid=645570)[0m \end{align*}

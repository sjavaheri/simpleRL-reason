[36m(main_task pid=645570)[0m The midpoint of three edges of a cube are connected, as shown below.  Find $\angle XYZ,$ in degrees
[36m(main_task pid=645570)[0m 
[36m(main_task pid=645570)[0m [asy]
[36m(main_task pid=645570)[0m unitsize(1.2 cm);
[36m(main_task pid=645570)[0m 
[36m(main_task pid=645570)[0m pair A, B, C, D, T, X, Y, Z;
[36m(main_task pid=645570)[0m pair x, y, z;
[36m(main_task pid=645570)[0m 
[36m(main_task pid=645570)[0m x = (2,-0.2);
[36m(main_task pid=645570)[0m y = (1.2,0.8);
[36m(main_task pid=645570)[0m z = (0,2);
[36m(main_task pid=645570)[0m 
[36m(main_task pid=645570)[0m X = (0,0);
[36m(main_task pid=645570)[0m Y = x;
[36m(main_task pid=645570)[0m T = y;
[36m(main_task pid=645570)[0m A = z;
[36m(main_task pid=645570)[0m Z = x + y;
[36m(main_task pid=645570)[0m B = x + z;
[36m(main_task pid=645570)[0m D = y + z;
[36m(main_task pid=645570)[0m C = x + y + z;
[36m(main_task pid=645570)[0m 
[36m(main_task pid=645570)[0m draw((C + D)/2--(B + C)/2--(B + Y)/2,red);
[36m(main_task pid=645570)[0m draw(X--Y--Z--C--D--A--cycle);
[36m(main_task pid=645570)[0m draw(B--A);
[36m(main_task pid=645570)[0m draw(B--C);
[36m(main_task pid=645570)[0m draw(B--Y);
[36m(main_task pid=645570)[0m draw(T--X,dashed);
[36m(main_task pid=645570)[0m draw(T--D,dashed);
[36m(main_task pid=645570)[0m draw(T--Z,dashed);
[36m(main_task pid=645570)[0m 
[36m(main_task pid=645570)[0m label("$X$", (C + D)/2, N);
[36m(main_task pid=645570)[0m label("$Y$", (B + C)/2, SE);
[36m(main_task pid=645570)[0m label("$Z$", (B + Y)/2, W);

[36m(main_task pid=645570)[0m 
[36m(main_task pid=645570)[0m # Total length of both ribbons
[36m(main_task pid=645570)[0m total_ribbon_length = red_ribbon_length + blue_ribbon_length
[36m(main_task pid=645570)[0m print(total_ribbon_length)
[36m(main_task pid=645570)[0m ```

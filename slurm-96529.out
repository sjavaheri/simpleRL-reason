[36m(main_task pid=645570)[0m \[ w = \frac{-(4\sqrt{3} + 6) \pm \sqrt{(4\sqrt{3} + 6)^2 + 4(4\sqrt{3} + 7)}}{2} \]
[36m(main_task pid=645570)[0m \[ w = \frac{-(4\sqrt{3} + 6) \pm \sqrt{48 + 48\sqrt{3} + 36 + 16\sqrt{3} + 28}}{2} \]
[36m(main_task pid=645570)[0m \[ w = \frac{-(4\sqrt{3} + 6) \pm \sqrt{104 + 64\sqrt{3}}}{2} \]
[36m(main_task pid=645570)[0m \[ w = \frac{-(4\sqrt{3} + 6) \pm \sqrt{(4\sqrt{3} + 6)(16\sqrt{3} - 14)}}{2} \]
[36m(main_task pid=645570)[0m \[ w = \frac{-(4\sqrt{3} + 6) \pm \sqrt{16(123 - 120)}}{2} \]
[36m(main_task pid=645570)[0m \[ w = \frac{-(4\sqrt{3} + 6) \pm 6\sqrt{13 - 5}}{2} \]
[36m(main_task pid=645570)[0m \[ w = \frac{-(4\sqrt{3} + 6) \pm 6\sqrt{8 - 5}}{2} \]
[36m(main_task pid=645570)[0m \[ w = \frac{-(4\sqrt{3} + 6) \pm 6\sqrt{3}}{2} \]
[36m(main_task pid=645570)[0m \[ w = \frac{-4\sqrt{3} - 6 \pm 6\sqrt{3}}{2} \]
[36m(main_task pid=645570)[0m \[ w = \frac{6\sqrt{3} - 4\sqrt{3}}{2} \text{ or } w = \frac{-4\sqrt{3} - 6 - 6\sqrt{3}}{2} \]
[36m(main_task pid=645570)[0m \[ w = \sqrt{3} \text{ or } w = 2 - 8\sqrt{3} \]

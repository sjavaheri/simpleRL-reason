[36m(main_task pid=645570)[0m import graph;
[36m(main_task pid=645570)[0m 
[36m(main_task pid=645570)[0m unitsize(2 cm);
[36m(main_task pid=645570)[0m 
[36m(main_task pid=645570)[0m pair O, A, B, C, D, E;
[36m(main_task pid=645570)[0m 

[36m(main_task pid=645570)[0m 
[36m(main_task pid=645570)[0m eq1 = sp.Eq(x**y, 1)
[36m(main_task pid=645570)[0m eq2 = sp.Eq(x+y, 1)
[36m(main_task pid=645570)[0m 
[36m(main_task pid=645570)[0m # résolution d'équations complets
[36m(main_task pid=645570)[0m solutions_xy = sp.solveset(eq1 - eq2, x, domain=sp.S.Reals)
[36m(main_task pid=645570)[0m solutions_yx = sp.solveset(eq1 - eq2, y, domain=sp.S.Reals)
[36m(main_task pid=645570)[0m 
[36m(main_task pid=645570)[0m # déterminer le résultat (élan d'utilisation pour un repose)

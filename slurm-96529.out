[36m(main_task pid=645570)[0m $\frac{ - 18 - 48]*)  (n - 3) = 14$
[36m(main_task pid=645570)[0m $\frac{ 18 + 48*)  (n - 8) = 16$
[36m(main_task pid=645570)[0m $\frac{ - 16 - 48*)  (n - 4) = 4$
[36m(main_task pid=645570)[0m $\frac{ - - 32)}(n + 5) = 1$
[36m(main_task pid=645570)[0m $\frac{ 16 + 32  (n - 1) = 24$
[36m(main_task pid=645570)[0m $\frac{ 18 - 32]  (n -10) = 14$
[36m(main_task pid=645570)[0m $\frac{ 24 - * anyways)
[36m(main_task pid=645570)[0m  n - 5 = 4$
[36m(main_task pid=645570)[0m $\frac{ 24 - * anyways)
[36m(main_task pid=645570)[0m n - 11 = -6$
[36m(main_task pid=645570)[0m $\frac{ 24 + *bitrary)
[36m(main_task pid=645570)[0m n - 9 = 0$

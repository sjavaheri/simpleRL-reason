[36m(main_task pid=645570)[0m $\frac{ 10 + (5 + (-11))/(9 - n) + (-5 + 7)/(5 - n) + (-9 + 1)/(11 - n) + (-11 + 2)/(6 - n) + (-1 + 8)/(5 - n) + (-2 + 5)/(10 - n) + (-5 + 8)/(6 - n) + (-7 + 3)/(11 - 7) + (-9 + 1)/(10 - 1)  + (-11 + 4)/(6 + 3) + (-2 + 5)/(6 - 5)  + (-7 + 2)/(9 + 2)  + (-5 + 3)/(6 - 5)  + (-11 + 4)/(10 - 6) + (-9 + 5)/(10 + 1)  + (-4 + 6)/(10 + 4) + (-7 + 1)/(10 - 7)  + (-2 + 4)/(6 + 10)  + (-6 + 5)/(8 - 5) + (-4 + 6)/(9 + 4) + (-8 + 6)/(6 + 8) + (-5 + 7)/(9 + 10)  + (-10 + 7)/(1 + 10)  + (-5 + 10)/(7 + 9)  + (-10 + 5)/(10 + 9) ; = 10$ as each term is even.

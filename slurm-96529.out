[36m(main_task pid=645570)[0m \begin{align*}
[36m(main_task pid=645570)[0m \dbinom{22}{19} &= \dfrac{22!}{19!(22-19)!}\\
[36m(main_task pid=645570)[0m &= \dfrac{22!}{19!13!}\\
[36m(main_task pid=645570)[0m &= \dfrac{22\times21\times20}{19\times18\times17\times16\times15\times14\times13}\\
[36m(main_task pid=645570)[0m &= \dfrac{22}{13}\\
[36m(main_task pid=645570)[0m &= 2

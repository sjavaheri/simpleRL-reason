[36m(main_task pid=645570)[0m      \frac{3}{8}(-17) + (-7) &= 16t \\
[36m(main_task pid=645570)[0m      16t(3) + 16& = 6 \\
[36m(main_task pid=645570)[0m      2 + t &= 1 \\
[36m(main_task pid=645570)[0m      t &= 1 \\
[36m(main_task pid=645570)[0m      P_1 = (16, 0, 7)
[36m(main_task pid=645570)[0m      \end{align*}$$

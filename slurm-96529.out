[36m(main_task pid=645570)[0m height_A = [int(x) for x in input().split()]
[36m(main_task pid=645570)[0m height_B = [int(x) for x in input().split()]
[36m(main_task pid=645570)[0m 
[36m(main_task pid=645570)[0m # Calculate maximal support curve height
[36m(main_task pid=645570)[0m max_support_height = max_support_curve(height_A, height_B)
[36m(main_task pid=645570)[0m print(max_support_height)

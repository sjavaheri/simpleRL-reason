[36m(main_task pid=645570)[0m 
[36m(main_task pid=645570)[0m \[
[36m(main_task pid=645570)[0m x = \frac{-14 \pm \sqrt{14^2 - 4(1)(-92)}}{2(1)}
[36m(main_task pid=645570)[0m \]
[36m(main_task pid=645570)[0m \[
[36m(main_task pid=645570)[0m x = \frac{-14 \pm \sqrt{196 + 368}}{2}
[36m(main_task pid=645570)[0m \]
[36m(main_task pid=645570)[0m \[
[36m(main_task pid=645570)[0m x = \frac{-14 \pm \sqrt{564}}{2}
[36m(main_task pid=645570)[0m \]
[36m(main_task pid=645570)[0m 

[36m(main_task pid=645570)[0m z = -6 + 16t
[36m(main_task pid=645570)[0m \end{cases}
[36m(main_task pid=645570)[0m \]
[36m(main_task pid=645570)[0m or equivalently:
[36m(main_task pid=645570)[0m \[

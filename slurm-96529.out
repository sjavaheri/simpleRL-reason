[36m(main_task pid=645570)[0m &(b + 1)^3 + (a + 1)^3 &= (a - 1)^{3} \\
[36m(main_task pid=645570)[0m &\qquad (c)^3 + (d)^3 = (a - 1)^{3} \\
[36m(main_task pid=645570)[0m &\qquad (a - 1 - (b - 1)^{3} )^2 + (a - 1 - (b + 1)^{3}\)^2 =\end{align*}

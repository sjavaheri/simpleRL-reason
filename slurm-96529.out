[36m(main_task pid=645570)[0m \[
[36m(main_task pid=645570)[0m 84z = \frac{1948z}{13 - a} + cz
[36m(main_task pid=645570)[0m \]
[36m(main_task pid=645570)[0m \[
[36m(main_task pid=645570)[0m 84z(1 - \frac{13 - a}{42}) = \frac{1948z}{13 - a}
[36m(main_task pid=645570)[0m \]
[36m(main_task pid=645570)[0m \[

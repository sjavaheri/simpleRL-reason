[36m(main_task pid=645570)[0m \[
[36m(main_task pid=645570)[0m \begin{aligned}
[36m(main_task pid=645570)[0m 1 + 2 &= 3 \\
[36m(main_task pid=645570)[0m 3 + 3 &= 6 \\
[36m(main_task pid=645570)[0m 6 + 4 &= 10 \\
[36m(main_task pid=645570)[0m 10 + 6 &= 16 \\
[36m(main_task pid=645570)[0m 16 + 12 &= 28 \\
[36m(main_task pid=645570)[0m \end{aligned}
[36m(main_task pid=645570)[0m \]

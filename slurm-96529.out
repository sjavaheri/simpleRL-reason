[36m(main_task pid=645570)[0m draw((0,i)--(4,i));
[36m(main_task pid=645570)[0m draw((k,0)--(k,3));
[36m(main_task pid=645570)[0m } }
[36m(main_task pid=645570)[0m 
[36m(main_task pid=645570)[0m draw((0,0)--(1,3));
[36m(main_task pid=645570)[0m draw((3,3)--(4,0));
[36m(main_task pid=645570)[0m 
[36m(main_task pid=645570)[0m label("$A$",(0,0),SW);
[36m(main_task pid=645570)[0m label("$B$",(4,0),SE);
[36m(main_task pid=645570)[0m label("$C$",(4,3),NE);
[36m(main_task pid=645570)[0m label("$D$",(0,3),NW);

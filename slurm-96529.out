[36m(main_task pid=645570)[0m \]
[36m(main_task pid=645570)[0m \[
[36m(main_task pid=645570)[0m 24z (12a - 13) = \frac{1948z}{13 - a}
[36m(main_task pid=645570)[0m \]
[36m(main_task pid=645570)[0m \[
[36m(main_task pid=645570)[0m 24z \cdot 12a = \frac{1948z(13 - a)}{13 - a}
[36m(main_task pid=645570)[0m \]
[36m(main_task pid=645570)[0m \[
[36m(main_task pid=645570)[0m 288aza = 1948z(13 - a)
[36m(main_task pid=645570)[0m \]
[36m(main_task pid=645570)[0m \[

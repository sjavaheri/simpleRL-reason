[36m(main_task pid=645570)[0m draw(p--q--r--cycle--t);
[36m(main_task pid=645570)[0m label("$P$", p, N);
[36m(main_task pid=645570)[0m label("$Q$", q, SW);
[36m(main_task pid=645570)[0m label("$T$", t, S);
[36m(main_task pid=645570)[0m label("$R$", r, SE);
[36m(main_task pid=645570)[0m label("$6$", midpoint(q--t), S, fontsize(10));

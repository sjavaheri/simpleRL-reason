[36m(main_task pid=645570)[0m             intrinsic_combinations += len(list(filter(lambda xs: xs[2] == fifth_digit, combinations + combinations % 10 + combinations / 10))) #7th and 8th
[36m(main_task pid=645570)[0m         else:
[36m(main_task pid=645570)[0m             intrinsic_combinations += len(list(filter(lambda xs: xs[2] == fifth_digit, combinations + combinations / 10))) # 6th and 7th
[36m(main_task pid=645570)[0m         
[36m(main_task pid=645570)[0m         combination_sum = sum(intrinsic_combinations)
[36m(main_task pid=645570)[0m         initial_combinations += sum(intrinsic_combinations)

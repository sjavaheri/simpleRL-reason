[36m(main_task pid=645570)[0m v = np.array([-1, -3, -5])
[36m(main_task pid=645570)[0m w = np.array([3, k, 7])
[36m(main_task pid=645570)[0m 
[36m(main_task pid=645570)[0m # Calculate the determinant
[36m(main_task pid=645570)[0m det = np.linalg.det(v * w.transpose() - np.array([v, w]))

[36m(main_task pid=645570)[0m r1 = 3
[36m(main_task pid=645570)[0m theta1 = math.pi / 2  # 3π/2
[36m(main_task pid=645570)[0m r2 = 9
[36m(main_task pid=645570)[0m theta2 = math.pi
[36m(main_task pid=645570)[0m 
[36m(main_task pid=645570)[0m # Calculate the distance
[36m(main_task pid=645570)[0m AB = math.sqrt((r2 - r1) ** 2 + (math.cos(theta2) - math.sin(theta2)) ** 2)

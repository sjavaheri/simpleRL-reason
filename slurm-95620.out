[36m(main_task pid=2119687)[0m A = (0,0,0);
[36m(main_task pid=2119687)[0m B = (1,0,0);
[36m(main_task pid=2119687)[0m C = (1,1,0);
[36m(main_task pid=2119687)[0m D= (0,1,0);

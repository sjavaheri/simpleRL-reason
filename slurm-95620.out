[36m(main_task pid=2119687)[0m In triangle $ABC,$ $M$ is the midpoint of $\overline{BC},$ $AB = 12,$ and $AC = 16.$  Let $E$ be on $\overline{AC},$ and $F$ be on $\overline{AB},$ and let $G$ be the intersection of $\overline{EF}$ and $\overline{AM}.$  If $AE = 2AF,$ then find $\frac{EG}{GF}.$
[36m(main_task pid=2119687)[0m 
[36m(main_task pid=2119687)[0m [asy]
[36m(main_task pid=2119687)[0m unitsize(0.3 cm);
[36m(main_task pid=2119687)[0m 
[36m(main_task pid=2119687)[0m pair A, B, C, E, F, G, M;
[36m(main_task pid=2119687)[0m real x = 4;
[36m(main_task pid=2119687)[0m 
[36m(main_task pid=2119687)[0m B = (0,0);
[36m(main_task pid=2119687)[0m C = (18,0);
[36m(main_task pid=2119687)[0m A = intersectionpoint(arc(B,12,0,180),arc(C,16,0,180));
[36m(main_task pid=2119687)[0m M = (B + C)/2;
[36m(main_task pid=2119687)[0m F = interp(A,B,x/12);
[36m(main_task pid=2119687)[0m E = interp(A,C,2*x/16);
[36m(main_task pid=2119687)[0m G = extension(E,F,A,M);
[36m(main_task pid=2119687)[0m 
[36m(main_task pid=2119687)[0m draw(A--B--C--cycle);
[36m(main_task pid=2119687)[0m draw(E--F);
[36m(main_task pid=2119687)[0m draw(A--M);
[36m(main_task pid=2119687)[0m 
[36m(main_task pid=2119687)[0m label("$A$", A, N);
[36m(main_task pid=2119687)[0m label("$B$", B, SW);
[36m(main_task pid=2119687)[0m label("$C$", C, SE);
[36m(main_task pid=2119687)[0m label("$E$", E, NE);
[36m(main_task pid=2119687)[0m label("$F$", F, NW);
[36m(main_task pid=2119687)[0m label("$G$", G, SW);
[36m(main_task pid=2119687)[0m label("$M$", M, S);
[36m(main_task pid=2119687)[0m [/asy]

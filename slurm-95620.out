[36m(main_task pid=2119687)[0m draw(shift(2.25,2)*box);
[36m(main_task pid=2119687)[0m draw(shift(1.5,4)*box);
[36m(main_task pid=2119687)[0m picture p;
[36m(main_task pid=2119687)[0m draw(p, (.6,.2)--(.95, .8), EndArrow);
[36m(main_task pid=2119687)[0m draw(p, (1.9,.2)--(1.55, .8), EndArrow);
[36m(main_task pid=2119687)[0m draw(p, (1.25, .8)--(1.25,.6));
[36m(main_task pid=2119687)[0m draw(p, (1.15, .7)--(1.35,.7));
[36m(main_task pid=2119687)[0m add(shift(0,1)*p);
[36m(main_task pid=2119687)[0m add(shift(1.5,1)*p);

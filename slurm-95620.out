[36m(main_task pid=2119687)[0m 6*5=30 & & 6*3=18 \\
[36m(main_task pid=2119687)[0m 17*5=85 & & 17*3=51 \\
[36m(main_task pid=2119687)[0m 24*5=120 & & 24*3=72 \\
[36m(main_task pid=2119687)[0m \end{align*}
[36m(main_task pid=2119687)[0m Since we have a column with a row having an $x$-value and a row had an $x$-value, we need to subtract the first index.
[36m(main_task pid=2119687)[0m \begin{align*}
[36m(main_task pid=2119687)[0m & 25-1=24 & & 30-18=22 \\
[36m(main_task pid=2119687)[0m & 15-1=14 & & 18-51=-33 \\
[36m(main_task pid=2119687)[0m & 85-85=0 & & 51-70=-19 \\
[36m(main_task pid=2119687)[0m & 120-15=105 & & 72-75=-3 \\
[36m(main_task pid=2119687)[0m \end{align*}
[36m(main_task pid=2119687)[0m and then, changing the order, a negative sign means we multiply by $-1$, so,
[36m(main_task pid=2119687)[0m \begin{align*}
[36m(main_task pid=2119687)[0m \begin{pmatrix}24 & 22\\ 14 & -33\end{pmatrix} \begin{pmatrix}0 & -19\\ -3 \\ \end{pmatrix} & = \\
[36m(main_task pid=2119687)[0m & =\begin{pmatrix} 0 * 0 + (-19) * (-3)& -(24) * (-3) \\ 14 * 0 + 3 * (-3)& 14 * (-3) \\ \end{pmatrix}  \\
[36m(main_task pid=2119687)[0m & =\begin{pmatrix}27 & 72 \\ -3 & -42 \end{pmatrix}
[36m(main_task pid=2119687)[0m \end{align*}

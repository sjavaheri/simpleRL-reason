[36m(main_task pid=2119687)[0m \[3^{4999} \equiv 20 \mod 10\]
[36m(main_task pid=2119687)[0m 
[36m(main_task pid=2119687)[0m Thus:
[36m(main_task pid=2119687)[0m \[
[36m(main_task pid=2119687)[0m 3^{1999} \equiv 20 \mod 10\]
[36m(main_task pid=2119687)[0m Thus:
[36m(main_task pid=2119687)[0m \[
[36m(main_task pid=2119687)[0m 3^{1999} \equiv 3^{k} \equiv 3^{6} \equiv 3^{-6} - 1
[36m(main_task pid=2119687)[0m \]
[36m(main_task pid=2119687)[0m 

[36m(main_task pid=2119687)[0m & =\left(e^{2 \frac{2}{\sqrt{5}}} -e^{2 \frac{2}{\sqrt{5}} + 8 \frac{\sqrt{5}}{5}})\right. +\left(e^{\frac{2 \sqrt{5}}{\sqrt{5}}} -e^{4 \frac{2\sqrt{5}}{5}}\right)\left(1+\frac{\sqrt{5}}{5}\right) \\

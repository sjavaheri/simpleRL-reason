[36m(main_task pid=2119687)[0m draw((2,0)--(2,3),linewidth(2));
[36m(main_task pid=2119687)[0m draw((4,0)--(4,3),linewidth(2));
[36m(main_task pid=2119687)[0m draw((6,0)--(6,3),linewidth(2));
[36m(main_task pid=2119687)[0m 

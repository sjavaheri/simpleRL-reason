[36m(main_task pid=2119687)[0m & \begin{bmatrix} \boxed{x} & \boxed{y}\\ \boxed{z} & \boxed{w} \end{bmatrix} & \begin{bmatrix} \boxed{x} & \boxed{z} \\ \boxed{w} & \boxed{y} \end{bmatrix} \\
[36m(main_task pid=2119687)[0m & \begin{bmatrix} \boxed{x+y-1.5} & \boxed{y-z} \\ \boxed{w+z} & \boxed{y} \end{bmatrix} & \begin{bmatrix} \boxed{x} & \boxed{z+y} \\ \boxed{w} & \boxed{y} \end{bmatrix}

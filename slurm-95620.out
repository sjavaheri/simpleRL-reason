[36m(main_task pid=2119687)[0m \begin{aligned} \frac {\sin^4 x + \cos^4 x - 1}{\sin^6 x + \cos^6 x - 1} &= \frac {(\sin^2 x)^2 + (\cos^2 x)^2 - 1}{\sin^2 x (\cos^6 x - 1) + \cos^2 x (\sin^6 x - 1)} \\ &= \frac {1 - \cos^2 x}{\cos^6 x (\sin^2 x + 1) - \sin^6 x (\cos^2 x + 1)} \\ &= \frac {\sin^2 x - \cos^2 x}{\sin^2 x (\cos^2 x + 1) - \cos^2 x (\cos^2 x + 1)} \\ &= \frac {\sin^2 x - \cos^2 x}{\sin^2 x - \cos^2 x} \\ &= \frac {\sin^2 x - \cos^2 x}{\sin^2 x - \cos^2 x} \end{aligned}

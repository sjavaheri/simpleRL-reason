[36m(main_task pid=2119687)[0m dot(Label("$C(4,3)$",align=NE),(4,3));
[36m(main_task pid=2119687)[0m dot(Label("$B(8,0)$",align=S),(8,0));
[36m(main_task pid=2119687)[0m draw((0,0)--(2,3)--(4,3)--(8,0));
[36m(main_task pid=2119687)[0m [/asy]

[36m(main_task pid=1078428)[0m def max_consecutive_sum(limit):
[36m(main_task pid=1078428)[0m     # Find the maximum number of consecutive positive integers that sum to <= limit
[36m(main_task pid=1078428)[0m     # by trying different combinations one by one.
[36m(main_task pid=1078428)[0m 
[36m(main_task pid=1078428)[0m     max_sum = 0
[36m(main_task pid=1078428)[0m     end = -1  # Initialize the end point to -1 to hold the last number added
[36m(main_task pid=1078428)[0m 
[36m(main_task pid=1078428)[0m     for start in range(1, int(limit ** 0.5) + 1):  # Start searching from the smallest integer
[36m(main_task pid=1078428)[0m         current_sum = 0
[36m(main_task pid=1078428)[0m         for i in range(start, start + (len(str(start)) // 2)):
[36m(main_task pid=1078428)[0m             current_sum += int(str(start)[i:])
[36m(main_task pid=1078428)[0m             

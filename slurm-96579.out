[36m(main_task pid=1078428)[0m def harmonic_ratio_powers_sum_terms(m, n):
[36m(main_task pid=1078428)[0m     """
[36m(main_task pid=1078428)[0m     This function calculates the sum of the harmonic ratio for all integer pairs (m, n) within a given interval m <= n.
[36m(main_task pid=1078428)[0m 
[36m(main_task pid=1078428)[0m     Parameters:
[36m(main_task pid=1078428)[0m     m (int): The upper limit of the interval for m.
[36m(main_task pid=1078428)[0m     n (int): The lower limit of the interval for n.
[36m(main_task pid=1078428)[0m 
[36m(main_task pid=1078428)[0m     Returns:
[36m(main_task pid=1078428)[0m     float: The sum of the harmonic ratio for all pairs of (m, n).
[36m(main_task pid=1078428)[0m     """
[36m(main_task pid=1078428)[0m     total_sum = 0.0
[36m(main_task pid=1078428)[0m     for m in range(1, m + 1):
[36m(main_task pid=1078428)[0m         for n in range(1, n + 1):
[36m(main_task pid=1078428)[0m             total_sum += 1 / (m * n * (m + n + 1))
[36m(main_task pid=1078428)[0m 
[36m(main_task pid=1078428)[0m     return total_sum
[36m(main_task pid=1078428)[0m 

[36m(main_task pid=1078428)[0m b = np.array([np.sqrt(7), 4, -1])
[36m(main_task pid=1078428)[0m c = np.array([13, -4, 17])
[36m(main_task pid=1078428)[0m 
[36m(main_task pid=1078428)[0m # Compute dot products
[36m(main_task pid=1078428)[0m ad_dot_bc = np.dot(a, c)
[36m(main_task pid=1078428)[0m ad_dot_bc = np.dot(a, b)
[36m(main_task pid=1078428)[0m a_dot_b = np.dot(a, b)
[36m(main_task pid=1078428)[0m 
[36m(main_task pid=1078428)[0m # Compute the vector (ad_dot_bc) - (a_dot_b) * c
[36m(main_task pid=1078428)[0m vector = vector = np.array([ad_dot_bc[0] - a_dot_b[0], ad_dot_bc[1] - a_dot_b[1], ad_dot_bc[2] - a_dot_b[2]])

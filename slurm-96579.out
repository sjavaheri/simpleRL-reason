[36m(main_task pid=1078428)[0m     if n < 0:
[36m(main_task pid=1078428)[0m         return False
[36m(main_task pid=1078428)[0m     root = int(n ** 0.5)
[36m(main_task pid=1078428)[0m     if root * root == n:
[36m(main_task pid=1078428)[0m         return True
[36m(main_task pid=1078428)[0m     return False
[36m(main_task pid=1078428)[0m 
[36m(main_task pid=1078428)[0m ways_to_find_perfect_squares_50_250 = 0
[36m(main_task pid=1078428)[0m for i in range(50, 251):
[36m(main_task pid=1078428)[0m 
[36m(main_task pid=1078428)[0m     square = (i - 1) * i
[36m(main_task pid=1078428)[0m     if is_perfect_square(square):

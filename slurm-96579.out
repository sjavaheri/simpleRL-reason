[36m(main_task pid=1078428)[0m 
[36m(main_task pid=1078428)[0m \[
[36m(main_task pid=1078428)[0m y = \frac{8}{3} - 3
[36m(main_task pid=1078428)[0m \]
[36m(main_task pid=1078428)[0m 
[36m(main_task pid=1078428)[0m \[
[36m(main_task pid=1078428)[0m y = \frac{8}{3} - \frac{9}{3}
[36m(main_task pid=1078428)[0m \]
[36m(main_task pid=1078428)[0m 
[36m(main_task pid=1078428)[0m \[

[36m(main_task pid=1078428)[0m draw((0,0)--(0,1)--(5,1)--(5,0)--cycle,linewidth(1));
[36m(main_task pid=1078428)[0m draw((1,0)--(1,2)--(4,2)--(4,0),linewidth(1));
[36m(main_task pid=1078428)[0m draw((2,-1)--(2,3)--(3,3)--(3,-1)--cycle,linewidth(1));
[36m(main_task pid=1078428)[0m draw((7,0)--(7,2)--(12,2)--(12,0)--cycle,linewidth(1));

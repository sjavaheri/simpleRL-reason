[36m(main_task pid=1078428)[0m The convex pentagon $ABCDE$ has $\angle A = \angle B = 120^\circ$, $EA = AB = BC = 2$ and $CD = DE = 4$.  What is the area of $ABCDE$?
[36m(main_task pid=1078428)[0m 
[36m(main_task pid=1078428)[0m [asy]
[36m(main_task pid=1078428)[0m 
[36m(main_task pid=1078428)[0m unitsize(1 cm);
[36m(main_task pid=1078428)[0m 
[36m(main_task pid=1078428)[0m pair A, B, C, D, E;
[36m(main_task pid=1078428)[0m 
[36m(main_task pid=1078428)[0m A = (0,0);
[36m(main_task pid=1078428)[0m 
[36m(main_task pid=1078428)[0m B = (1,0);
[36m(main_task pid=1078428)[0m 
[36m(main_task pid=1078428)[0m C = B + dir(60);
[36m(main_task pid=1078428)[0m 
[36m(main_task pid=1078428)[0m D = C + 2*dir(120);
[36m(main_task pid=1078428)[0m 
[36m(main_task pid=1078428)[0m E = dir(120);
[36m(main_task pid=1078428)[0m 
[36m(main_task pid=1078428)[0m draw(A--B--C--D--E--cycle);
[36m(main_task pid=1078428)[0m 
[36m(main_task pid=1078428)[0m label("$A$", A, SW);
[36m(main_task pid=1078428)[0m 
[36m(main_task pid=1078428)[0m label("$B$", B, SE);
[36m(main_task pid=1078428)[0m 
[36m(main_task pid=1078428)[0m label("$C$", C, dir(0));
[36m(main_task pid=1078428)[0m 
[36m(main_task pid=1078428)[0m label("$D$", D, N);
[36m(main_task pid=1078428)[0m 
[36m(main_task pid=1078428)[0m label("$E$", E, W);
[36m(main_task pid=1078428)[0m 

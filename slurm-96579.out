[36m(main_task pid=1078428)[0m d = sp.sqrt((center[0] + 1)**2 + (center[1] - 2)**2)
[36m(main_task pid=1078428)[0m 
[36m(main_task pid=1078428)[0m # Since the line segment from the center to the point P divides the circle into two equal parts

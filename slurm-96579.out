[36m(main_task pid=1078428)[0m P2 = Sp.d Containing_P_Sp_Ne_Ne_Ddot_Dx_=20
[36m(main_task pid=1078428)[0m P3 = Sp.d Containing_P_Sp_Ne_Ne_Ddot_Dz_=20
[36m(main_task pid=1078428)[0m 

[36m(main_task pid=1078428)[0m label("$C$",(10,0),E);
[36m(main_task pid=1078428)[0m label("$A$",(3.6,4.8),N);
[36m(main_task pid=1078428)[0m label("$B$",(0,0),W);
[36m(main_task pid=1078428)[0m label("10",(0,0)--(10,0),S);
[36m(main_task pid=1078428)[0m [/asy]
[36m(main_task pid=1078428)[0m Please reason step by step, and put your final answer within \boxed{{}}.<|im_end|>

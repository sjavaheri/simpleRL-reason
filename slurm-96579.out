[36m(main_task pid=1078428)[0m 7. A
[36m(main_task pid=1078428)[0m 8. A = 8nines
[36m(main_task pid=1078428)[0m 
[36m(main_task pid=1078428)[0m 0. 0 0 0 0 0
[36m(main_task pid=1078428)[0m 
[36m(main_task pid=1078428)[0m 1. B
[36m(main_task pid=1078428)[0m 
[36m(main_task pid=1078428)[0m 0. B C B
[36m(main_task pid=1078428)[0m 
[36m(main_task pid=1078428)[0m 0 B B B B B
[36m(main_task pid=1078428)[0m }
[36m(main_task pid=1078428)[0m }

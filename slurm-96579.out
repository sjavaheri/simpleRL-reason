[36m(main_task pid=1078428)[0m    k - 1 \\
[36m(main_task pid=1078428)[0m    4 - 2k
[36m(main_task pid=1078428)[0m    \end{pmatrix}
[36m(main_task pid=1078428)[0m    \]
[36m(main_task pid=1078428)[0m 
[36m(main_task pid=1078428)[0m    Now we can find the height \( h \):
[36m(main_task pid=1078428)[0m    \[
[36m(main_task pid=1078428)[0m    h = \frac{\begin{pmatrix}
[36m(main_task pid=1078428)[0m    2k^2 - k - 2 \\
[36m(main_task pid=1078428)[0m    k - 1 \\
[36m(main_task pid=1078428)[0m    4 - 2k
[36m(main_task pid=1078428)[0m    \end{pmatrix}}{\begin{pmatrix}

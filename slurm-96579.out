[36m(main_task pid=1078428)[0m In $\triangle ABC$, what is the value of $x + y$? [asy]
[36m(main_task pid=1078428)[0m import olympiad;
[36m(main_task pid=1078428)[0m size(7cm);
[36m(main_task pid=1078428)[0m 
[36m(main_task pid=1078428)[0m pair a = dir(76);
[36m(main_task pid=1078428)[0m pair b = (-1, 0);
[36m(main_task pid=1078428)[0m pair c = (1, 0);
[36m(main_task pid=1078428)[0m pair o = (0, 0);
[36m(main_task pid=1078428)[0m 
[36m(main_task pid=1078428)[0m draw(a--b--c--cycle);
[36m(main_task pid=1078428)[0m draw(a--o);
[36m(main_task pid=1078428)[0m 
[36m(main_task pid=1078428)[0m label("$A$", a, N); label("$B$", b, SW); label("$C$", c, SE);
[36m(main_task pid=1078428)[0m label("$104^\circ$", o, 1.8 * NW + 0.4 * E);
[36m(main_task pid=1078428)[0m label("$x^\circ$", b, 3 * E + NE + NE);
[36m(main_task pid=1078428)[0m label("$y^\circ$", c, 2 * W + 2 * NW);
[36m(main_task pid=1078428)[0m 
[36m(main_task pid=1078428)[0m add(pathticks(b--o, s=3));
[36m(main_task pid=1078428)[0m add(pathticks(c--o, s=3));
[36m(main_task pid=1078428)[0m add(pathticks(a--o, s=3));
[36m(main_task pid=1078428)[0m 

[36m(main_task pid=1078428)[0m draw((8,0)--(8,2),linewidth(1));
[36m(main_task pid=1078428)[0m draw((9,0)--(9,2),linewidth(1));
[36m(main_task pid=1078428)[0m draw((10,0)--(10,2),linewidth(1));

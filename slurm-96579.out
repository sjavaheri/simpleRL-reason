[36m(main_task pid=1078428)[0m draw(X); draw(Y);
[36m(main_task pid=1078428)[0m 
[36m(main_task pid=1078428)[0m for(int n=-6; n <= 5; ++n)
[36m(main_task pid=1078428)[0m if( n != 0 )
[36m(main_task pid=1078428)[0m draw( (n,0.25)--(n,-0.25) );
[36m(main_task pid=1078428)[0m for(int n=-3; n <= 7; ++n)
[36m(main_task pid=1078428)[0m if( n != 0 )
[36m(main_task pid=1078428)[0m draw( (0.25,n)--(-0.25,n) );
[36m(main_task pid=1078428)[0m 

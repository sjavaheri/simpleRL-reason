[36m(main_task pid=1078428)[0m print(f"Equation 2: C*D = 60")
[36m(main_task pid=1078428)[0m print(f"Equation 3: A - B = C + D")
[36m(main_task pid=1078428)[0m 
[36m(main_task pid=1078428)[0m print(sp.simplify(sp.solve((eq1, eq2), (A, B, C, D)))[0])
[36m(main_task pid=1078428)[0m 
[36m(main_task pid=1078428)[0m ```

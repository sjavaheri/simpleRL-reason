[36m(main_task pid=1078428)[0m 
[36m(main_task pid=1078428)[0m # That can be accomplished as a vacuum query of our polynomial to make sure
[36m(main_task pid=1078428)[0m # all intermediate terms = 0 at n= 2+3 =~ 5 and the answer is the calculated n indeed!
[36m(main_task pid=1078428)[0m n = [denominator.value for denominator in poly if denominator == 0 and polynomial_variables.count(variable == 7)].count(7) + 1
[36m(main_task pid=1078428)[0m 
[36m(main_task pid=1078428)[0m # Checking if the condition prevails as an applying = 7 makes all variables no and possible in op function

[36m(main_task pid=1078428)[0m draw(unitsquare);
[36m(main_task pid=1078428)[0m draw(shift(up)*shift(right)*unitsquare);
[36m(main_task pid=1078428)[0m filldraw(shift(up)*unitsquare,gray(.6));
[36m(main_task pid=1078428)[0m filldraw(shift(right)*unitsquare,gray(.6));
[36m(main_task pid=1078428)[0m draw((0,0)--(2,2)^^(0,2)--(2,0));

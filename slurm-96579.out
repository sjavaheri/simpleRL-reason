[36m(main_task pid=1078428)[0m circle_eq = x**2 + y**2 + 2*x - 4*y + 3
[36m(main_task pid=1078428)[0m 
[36m(main_task pid=1078428)[0m # Substitute y from circle equation to get the line equation.

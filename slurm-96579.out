[36m(main_task pid=1078428)[0m Find the volume of this solid in terms of $\pi$.
[36m(main_task pid=1078428)[0m 
[36m(main_task pid=1078428)[0m [asy]
[36m(main_task pid=1078428)[0m import solids; size(200); import three; defaultpen(linewidth(0.8)); currentprojection = orthographic(5,0,3);
[36m(main_task pid=1078428)[0m revolution c = cylinder((0,0,0), sqrt(3), 10);
[36m(main_task pid=1078428)[0m revolution c2 = cone((0,0,10), sqrt(3), 10);
[36m(main_task pid=1078428)[0m draw(c,black);
[36m(main_task pid=1078428)[0m draw(c2,black);
[36m(main_task pid=1078428)[0m draw((3,0)--(3,8.5),Arrows(TeXHead));
[36m(main_task pid=1078428)[0m label("10",(3,0)--(3,8.5),E);

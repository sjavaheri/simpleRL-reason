[36m(main_task pid=1078428)[0m The length of the shortest trip from $A$ to $B$ along the edges of the cube shown is the length of 3 edges. How many different 3-edge trips are there from $A$ to $B$?
[36m(main_task pid=1078428)[0m 
[36m(main_task pid=1078428)[0m [asy]
[36m(main_task pid=1078428)[0m 
[36m(main_task pid=1078428)[0m size(4cm,4cm);
[36m(main_task pid=1078428)[0m 
[36m(main_task pid=1078428)[0m pair a1, b1, c1, d1;
[36m(main_task pid=1078428)[0m 
[36m(main_task pid=1078428)[0m a1=(1,1);
[36m(main_task pid=1078428)[0m b1=(0,1);
[36m(main_task pid=1078428)[0m c1=(1.6,1.4);
[36m(main_task pid=1078428)[0m d1=(1,0);
[36m(main_task pid=1078428)[0m 
[36m(main_task pid=1078428)[0m pair e1, f1, g1, h1;
[36m(main_task pid=1078428)[0m 
[36m(main_task pid=1078428)[0m e1=(0,0);
[36m(main_task pid=1078428)[0m f1=c1-(a1-d1);
[36m(main_task pid=1078428)[0m g1=b1+(c1-a1);
[36m(main_task pid=1078428)[0m h1=e1+(g1-b1);
[36m(main_task pid=1078428)[0m 
[36m(main_task pid=1078428)[0m draw(a1--d1--e1--b1--a1);
[36m(main_task pid=1078428)[0m draw(b1--g1--c1--a1);
[36m(main_task pid=1078428)[0m draw(c1--f1--d1);
[36m(main_task pid=1078428)[0m draw(g1--h1--e1,dotted+1pt);
[36m(main_task pid=1078428)[0m draw(h1--f1,dotted+1pt);
[36m(main_task pid=1078428)[0m 
[36m(main_task pid=1078428)[0m label("$A$",e1,SW);
[36m(main_task pid=1078428)[0m label("$B$",c1,NE);
[36m(main_task pid=1078428)[0m 
[36m(main_task pid=1078428)[0m [/asy]

[36m(main_task pid=1078428)[0m result = (sp.S.Repr(P1) * sp.S.Repr(d) == sp.S.Repr(P2) * sp.S.Repr(d) and sp.S.Repr(P3) * sp.S.Repr(d) == sp.S.Repr(P1) * sp.S.Repr(d))
[36m(main_task pid=1078428)[0m print(result)

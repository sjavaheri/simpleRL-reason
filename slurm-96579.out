[36m(main_task pid=1078428)[0m ITERATE SELECT_SQL_FROM__TASKWHERE SUBSTRING_INDEX(SUBSTRING_INDEX(SUBSTRING(@sel_a1, 799106925,  LENGTH(@sel_a1)-6),  NULL,  6) ,'__', 0) = 'S' AND ____ NOT LIKE '%')；
[36m(main_task pid=1078428)[0m ```

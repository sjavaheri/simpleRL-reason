[36m(main_task pid=1983818)[0m =
[36m(main_task pid=1983818)[0m \frac{8}{4^{501}}
[36m(main_task pid=1983818)[0m \]
[36m(main_task pid=1983818)[0m 
[36m(main_task pid=1983818)[0m 3. \(\frac {8}{4^502}\)
[36m(main_task pid=1983818)[0m 

[36m(main_task pid=1983818)[0m c_expr = sp.solve(sp.Eq(c, c_value), c)[0]
[36m(main_task pid=1983818)[0m 
[36m(main_task pid=1983818)[0m # Compute the desired expression
[36m(main_task pid=1983818)[0m result = a_expr**2 + b_expr**2 + c_expr**2 + 2*a_expr*b_expr*c_expr
[36m(main_task pid=1983818)[0m result = sp.simplify(result)
[36m(main_task pid=1983818)[0m print(result)

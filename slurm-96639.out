[36m(main_task pid=1983818)[0m label("$P$", p, N);
[36m(main_task pid=1983818)[0m label("$12$", r + (p - r) / 2, SE);
[36m(main_task pid=1983818)[0m label("$8$", r + (q - r) / 2, S);
[36m(main_task pid=1983818)[0m label("$120^\circ$", r, NW + 0.2 * E);
[36m(main_task pid=1983818)[0m 

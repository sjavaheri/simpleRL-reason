[36m(main_task pid=1983818)[0m \]
[36m(main_task pid=1983818)[0m \[
[36m(main_task pid=1983818)[0m \dfrac{1}{x^2} + \dfrac{1}{x^3} = \dfrac{1}{x^2} + \dfrac{1}{x} \cdot x = \dfrac{1}{x^2} + \dfrac{1}{x} = \dfrac{2}{x}
[36m(main_task pid=1983818)[0m \]
[36m(main_task pid=1983818)[0m \[
[36m(main_task pid=1983818)[0m 2\sinh^2(x) + 1 - 4 + \dfrac{1}{x^2} + \dfrac{1}{x^3} - \dfrac{1}{x^2} = 2\sinh^2(x) + 1 - 4 + \dfrac{1}{x^2} + \dfrac{1}{x^3} - \dfrac{1}{x^2}
[36m(main_task pid=1983818)[0m \]
[36m(main_task pid=1983818)[0m \[
[36m(main_task pid=1983818)[0m \dfrac{1}{x^2} + \dfrac{1}{x^3} = 2\sinh^2(1) + \dfrac{1}{x}
[36m(main_task pid=1983818)[0m \]
[36m(main_task pid=1983818)[0m \[

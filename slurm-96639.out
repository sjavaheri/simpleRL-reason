[36m(main_task pid=1983818)[0m How many paths are there from $A$ to $C$, if every step must be up or to the right?[asy]size(4cm,4cm);int w=6;int h=5;int i;pen p=fontsize(9);for (i=0; i<h; ++i){draw((0,i) -- (w-1,i));}for (i=0; i<w; ++i){draw((i, 0)--(i,h-1));}label("A", (0,0), SW, p);label("C", (1,2), NE, p);label("B", (w-1,h-1), NE, p);[/asy]

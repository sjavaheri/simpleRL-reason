[36m(main_task pid=1983818)[0m SS = (-2,0);
[36m(main_task pid=1983818)[0m P = (0,0);
[36m(main_task pid=1983818)[0m Q = (2,0);
[36m(main_task pid=1983818)[0m R = rotate(aSin(7/25))*(1.5,0);
[36m(main_task pid=1983818)[0m dot("$S$",SS,S);
[36m(main_task pid=1983818)[0m dot("$Q$",Q,S);
[36m(main_task pid=1983818)[0m dot("$R$",R,N);
[36m(main_task pid=1983818)[0m dot("$P$",P,S);
[36m(main_task pid=1983818)[0m draw(Q--SS);
[36m(main_task pid=1983818)[0m draw(P--R);

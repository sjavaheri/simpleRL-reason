[36m(main_task pid=1983818)[0m label("$B$",B,SW);
[36m(main_task pid=1983818)[0m label("$C$",C,SE);
[36m(main_task pid=1983818)[0m label("$D$",D,W);
[36m(main_task pid=1983818)[0m label("$E$",E,S);
[36m(main_task pid=1983818)[0m label("$F$",F,dir(0));

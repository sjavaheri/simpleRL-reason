[36m(main_task pid=1983818)[0m 
[36m(main_task pid=1983818)[0m # Factorize the expression
[36m(main_task pid=1983818)[0m factors = sp.primefactors(expression)
[36m(main_task pid=1983818)[0m 
[36m(main_task pid=1983818)[0m # Printing the factors
[36m(main_task pid=1983818)[0m print(factors)
[36m(main_task pid=1983818)[0m ```

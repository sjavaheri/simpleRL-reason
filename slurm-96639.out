[36m(main_task pid=1983818)[0m x = symbols('x', real=True)
[36m(main_task pid=1983818)[0m 
[36m(main_task pid=1983818)[0m # Step 1: Solve the equation x(x-3) = 1
[36m(main_task pid=1983818)[0m eq = Eq(x * (x - 3), 1)

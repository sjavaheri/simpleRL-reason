[36m(main_task pid=1983818)[0m f_pos = [f.subs(x, point) for point in critical_points]
[36m(main_task pid=1983818)[0m f_neg_pos = [f.subs(x, -point) for point in critical_points]
[36m(main_task pid=1983818)[0m 

[36m(main_task pid=1983818)[0m 
[36m(main_task pid=1983818)[0m \[
[36m(main_task pid=1983818)[0m 14! - 7 \times 13! = 87,777,576 - 7 \times 40,320 = 87,777,576 - 282,840 = 87,494,736

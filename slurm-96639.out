[36m(main_task pid=1983818)[0m 
[36m(main_task pid=1983818)[0m # Define the variable
[36m(main_task pid=1983818)[0m x = sp.symbols('x')
[36m(main_task pid=1983818)[0m 
[36m(main_task pid=1983818)[0m # Define the equation
[36m(main_task pid=1983818)[0m eq = sp.tan(4*x) - (sp.cos(x) - sp.sin(x)) / (sp.cos(x) + sp.sin(x))
[36m(main_task pid=1983818)[0m 
[36m(main_task pid=1983818)[0m # Simplify the equation

[36m(main_task pid=1983818)[0m \begin{align*}
[36m(main_task pid=1983818)[0m & (r^3 - 20r^2 + 18r - 7) + (s^3 - 20s^2 + 18s - 7) + (t^3 - 20t^2 + 18t - 7) \\
[36m(main_task pid=1983818)[0m = &(r^3 + t^3) + (-20(r^2+s^2) + 18(r+s+t)) - 21(r + s + t) \\
[36m(main_task pid=1983818)[0m = &(r + t)^3 - 20(rs + st + tr)^2 + 18(rs + rt + st)^2 - 21(rs + st + tr) \\
[36m(main_task pid=1983818)[0m = \cdots \\
[36m(main_task pid=1983818)[0m &= 0
[36m(main_task pid=1983818)[0m \end{align*}
[36m(main_task pid=1983818)[0m 

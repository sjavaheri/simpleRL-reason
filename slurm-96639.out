[36m(main_task pid=1983818)[0m \]
[36m(main_task pid=1983818)[0m 
[36m(main_task pid=1983818)[0m Multiply both sides by 16 to clear the fractions:
[36m(main_task pid=1983818)[0m 
[36m(main_task pid=1983818)[0m \[
[36m(main_task pid=1983818)[0m 8 + 8\sqrt{5} - 16\cos^2 x = 1
[36m(main_task pid=1983818)[0m \]
[36m(main_task pid=1983818)[0m 
[36m(main_task pid=1983818)[0m \[
[36m(main_task pid=1983818)[0m 12 + 8\sqrt{5} - 16\cos^2 x = 16
[36m(main_task pid=1983818)[0m \]
[36m(main_task pid=1983818)[0m 
[36m(main_task pid=1983818)[0m Solve for \(\cos^2 x\):
[36m(main_task pid=1983818)[0m 
[36m(main_task pid=1983818)[0m \[
[36m(main_task pid=1983818)[0m 16\cos^2 x = 16 - 8 - 8\sqrt{5}
[36m(main_task pid=1983818)[0m \]
[36m(main_task pid=1983818)[0m 
[36m(main_task pid=1983818)[0m \[
[36m(main_task pid=1983818)[0m 16\cos^2 x = 8 - 8\sqrt{5}
[36m(main_task pid=1983818)[0m \]
[36m(main_task pid=1983818)[0m 
[36m(main_task pid=1983818)[0m \[
[36m(main_task pid=1983818)[0m \cos^2 x = \frac{8 - 8\sqrt{5}}{16}
[36m(main_task pid=1983818)[0m \]
[36m(main_task pid=1983818)[0m 
[36m(main_task pid=1983818)[0m \[
[36m(main_task pid=1983818)[0m \cos^2 x = \frac{2 - \sqrt{5}}{4}
[36m(main_task pid=1983818)[0m \]
[36m(main_task pid=1983818)[0m 
[36m(main_task pid=1983818)[0m Thus:
[36m(main_task pid=1983818)[0m 
[36m(main_task pid=1983818)[0m \[
[36m(main_task pid=1983818)[0m \sin^2 x = \frac{-1 + \sqrt{5}}{2}
[36m(main_task pid=1983818)[0m \]
[36m(main_task pid=1983818)[0m 
[36m(main_task pid=1983818)[0m Now, solve for \(x\) using the inverse sine function:
[36m(main_task pid=1983818)[0m 
[36m(main_task pid=1983818)[0m \[
[36m(main_task pid=1983818)[0m x = \sin^{-1} \left( \frac{-1 + \sqrt{5}}{2} \right) \quad \text{or} \quad x = \pi - \sin^{-1} \left( \frac{-1 + \sqrt{5}}{2} \right)
[36m(main_task pid=1983818)[0m \]
[36m(main_task pid=1983818)[0m 
[36m(main_task pid=1983818)[0m Using a calculator to find the inverse sine:

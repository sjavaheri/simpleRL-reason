[36m(main_task pid=1983818)[0m 
[36m(main_task pid=1983818)[0m ```python
[36m(main_task pid=1983818)[0m # Create a Python function to check if the sum of pairs of numbers is a perfect square
[36m(main_task pid=1983818)[0m def is_perfect_square(n):
[36m(main_task pid=1983818)[0m     # Find the integer squared root of n
[36m(main_task pid=1983818)[0m     sqrt_n = int(n**0.5)
[36m(main_task pid=1983818)[0m     # Check if the square of the integer equals n
[36m(main_task pid=1983818)[0m     return sqrt_n * sqrt_n == n
[36m(main_task pid=1983818)[0m 

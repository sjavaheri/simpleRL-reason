[36m(main_task pid=1983818)[0m pair A=(10,sqrt(28^2-100)),B=origin,C=(20,0),D=(A.x*r,A.y*r);
[36m(main_task pid=1983818)[0m pair bottom=(C.x+(D.x-A.x),C.y+(D.y-A.y));
[36m(main_task pid=1983818)[0m pair E=extension(D,bottom,B,C);
[36m(main_task pid=1983818)[0m pair top=(E.x+D.x,E.y+D.y);
[36m(main_task pid=1983818)[0m pair F=extension(E,top,A,C);
[36m(main_task pid=1983818)[0m draw(A--B--C--cycle^^D--E--F);
[36m(main_task pid=1983818)[0m dot(A^^B^^C^^D^^E^^F);

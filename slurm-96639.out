[36m(main_task pid=1983818)[0m total_women_wear_sunglasses = 2000
[36m(main_task pid=1983818)[0m total_men_wear_sunglasses = 2000
[36m(main_task pid=1983818)[0m total_employees = total_women_wear_sunglasses + total_men_wear_sunglasses
[36m(main_task pid=1983818)[0m 
[36m(main_task pid=1983818)[0m # Eq of on men wearing sunglasses and women wearing sunglasses
[36m(main_task pid=1983818)[0m lhs = M + L
[36m(main_task pid=1983818)[0m rhs = total_employees
[36m(main_task pid=1983818)[0m 

[36m(main_task pid=1983818)[0m vitamin_d_in_afternoon_abs = {'day1': 2, 'day2': 2, 'day3': 3, 'day4': 3}
[36m(main_task pid=1983818)[0m vitamin_c_in_afternoon_abs = {'day1': 2, 'day2': 2, 'day3': 3, 'day4': 6}

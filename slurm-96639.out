[36m(main_task pid=1983818)[0m     def out_of_orderer(listify):
[36m(main_task pid=1983818)[0m         """
[36m(main_task pid=1983818)[0m         If the list doesn't contain all the combinations necessary,
[36m(main_task pid=1983818)[0m         extract false, validate, return it to be else found.
[36m(main_task pid=1983818)[0m         If merger is done with each other element, optional uses the smaller

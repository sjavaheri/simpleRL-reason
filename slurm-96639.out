[36m(main_task pid=1983818)[0m [asy]
[36m(main_task pid=1983818)[0m size(100); real h = 1.2; currentpen = fontsize(10pt);
[36m(main_task pid=1983818)[0m draw(Label("$l$",Relative(1)),(0,0)--(1,0),E);
[36m(main_task pid=1983818)[0m draw(Label("$m$",Relative(1)),(0,-h)--(1,-h),E);
[36m(main_task pid=1983818)[0m draw((0,-h)--h/2*(cos(150*pi/180),sin(150*pi/180)) + (0,-h));
[36m(main_task pid=1983818)[0m draw(Label("$C$",Relative(1)),(0,0)--h*sqrt(3)/2*(cos(-120*pi/180),sin(-120*pi/180)),W);
[36m(main_task pid=1983818)[0m label("$A$",(0,0),N); label("$B$",(0,-h),S);
[36m(main_task pid=1983818)[0m label("$120^\circ$",(0,0),SE); label("$150^\circ$",(0,-h),NE);
[36m(main_task pid=1983818)[0m [/asy]

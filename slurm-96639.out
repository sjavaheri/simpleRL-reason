[36m(main_task pid=1983818)[0m The fifth, sixth and seventh terms of an arithmetic sequence are 5, 9 and 13, respectively. What is the sum of the first four terms of the sequence? [asy]
[36m(main_task pid=1983818)[0m unitsize(8mm);
[36m(main_task pid=1983818)[0m defaultpen(linewidth(.7pt)+fontsize(12pt));
[36m(main_task pid=1983818)[0m 
[36m(main_task pid=1983818)[0m label("\underline{\quad}, \underline{\quad}, \underline{\quad}, \underline{\quad}, \underline{ 5 }, \underline{ 9 }, \underline{ 13 }",(0,0),W);
[36m(main_task pid=1983818)[0m 
[36m(main_task pid=1983818)[0m draw((-2.3,0.4)..(-1.9,0.7)..(-1.5,0.4),EndArrow(4));
[36m(main_task pid=1983818)[0m label("\footnotesize{+ 4}",(-1.9,1.0));
[36m(main_task pid=1983818)[0m 
[36m(main_task pid=1983818)[0m draw((-1.3,0.4)..(-0.9,0.7)..(-0.5,0.4),EndArrow(4));
[36m(main_task pid=1983818)[0m label("\footnotesize{+ 4}",(-0.9,1.0));
[36m(main_task pid=1983818)[0m [/asy]

[36m(main_task pid=1983818)[0m lhs_neg_sqrt_b_val = -sqrt(b_expr**2 - 4*a_expr*c_val*c_sqrt_neg_b_expr)
[36m(main_task pid=1983818)[0m 
[36m(main_task pid=1983818)[0m # Check if they are equal
[36m(main_task pid=1983818)[0m solution_form = lhs_sqrt_b_val == lhs_neg_sqrt_b_val
[36m(main_task pid=1983818)[0m print((solution_x, solution_form))
[36m(main_task pid=1983818)[0m ```

[36m(main_task pid=1983818)[0m In a circle with center $O$, $AD$ is a diameter, $ABC$ is a chord, $BO = 5$, and $\angle ABO = \text{arc } CD = 60^\circ$.  Find the length of $BC$.
[36m(main_task pid=1983818)[0m 
[36m(main_task pid=1983818)[0m [asy]
[36m(main_task pid=1983818)[0m import graph;
[36m(main_task pid=1983818)[0m 
[36m(main_task pid=1983818)[0m unitsize(2 cm);
[36m(main_task pid=1983818)[0m 
[36m(main_task pid=1983818)[0m pair O, A, B, C, D;
[36m(main_task pid=1983818)[0m 
[36m(main_task pid=1983818)[0m O = (0,0);
[36m(main_task pid=1983818)[0m A = dir(30);
[36m(main_task pid=1983818)[0m C = dir(160);
[36m(main_task pid=1983818)[0m B = (2*C + A)/3;
[36m(main_task pid=1983818)[0m D = -A;
[36m(main_task pid=1983818)[0m 
[36m(main_task pid=1983818)[0m draw(Circle(O,1));
[36m(main_task pid=1983818)[0m draw(C--A--D);
[36m(main_task pid=1983818)[0m draw(B--O);
[36m(main_task pid=1983818)[0m 
[36m(main_task pid=1983818)[0m label("$A$", A, NE);
[36m(main_task pid=1983818)[0m label("$B$", B, N);
[36m(main_task pid=1983818)[0m label("$C$", C, W);
[36m(main_task pid=1983818)[0m label("$D$", D, SW);
[36m(main_task pid=1983818)[0m label("$O$", O, SE);
[36m(main_task pid=1983818)[0m [/asy]
[36m(main_task pid=1983818)[0m Please reason step by step, and put your final answer within \boxed{{}}.<|im_end|>

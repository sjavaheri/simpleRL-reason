[36m(main_task pid=1983818)[0m    23\cdot 17 = 391
[36m(main_task pid=1983818)[0m    \]
[36m(main_task pid=1983818)[0m    \[
[36m(main_task pid=1983818)[0m    61 + 391 - 200 - 312\div6

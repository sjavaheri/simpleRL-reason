[36m(main_task pid=1983818)[0m $$7 + 30 \times 2 = 37
[36m(main_task pid=1983818)[0m $$
[36m(main_task pid=1983818)[0m 
[36m(main_task pid=1983818)[0m $$7 + 30 \times 4 = 39
[36m(main_task pid=1983818)[0m $$
[36m(main_task pid=1983818)[0m 
[36m(main_task pid=1983818)[0m $$7 + 30 \times 6 = 41
[36m(main_task pid=1983818)[0m $$
[36m(main_task pid=1983818)[0m 
[36m(main_task pid=1983818)[0m $$7 + 30 \times 8 = 43
[36m(main_task pid=1983818)[0m $$
[36m(main_task pid=1983818)[0m 
[36m(main_task pid=1983818)[0m $$7 + 30 \times 10 = 45
[36m(main_task pid=1983818)[0m $$
[36m(main_task pid=1983818)[0m 
[36m(main_task pid=1983818)[0m $$7 + 30 \times 11 = 47
[36m(main_task pid=1983818)[0m $$
[36m(main_task pid=1983818)[0m 
[36m(main_task pid=1983818)[0m $$7 + 30 \times 12= 54
[36m(main_task pid=1983818)[0m $$
[36m(main_task pid=1983818)[0m 
[36m(main_task pid=1983818)[0m $$7 + 30 \times 15 = 71
[36m(main_task pid=1983818)[0m $$
[36m(main_task pid=1983818)[0m 
[36m(main_task pid=1983818)[0m $$7 + 30 \times 20= 107
[36m(main_task pid=1983818)[0m $$
[36m(main_task pid=1983818)[0m 
[36m(main_task pid=1983818)[0m $$7 + 30 \times 21= 135$$
[36m(main_task pid=1983818)[0m 
[36m(main_task pid=1983818)[0m $$7 + 30 \times 22 = 167
[36m(main_task pid=1983818)[0m $$
[36m(main_task pid=1983818)[0m 
[36m(main_task pid=1983818)[0m $$7 + 30 \times 23 = 193
[36m(main_task pid=1983818)[0m $$$$
[36m(main_task pid=1983818)[0m 
[36m(main_task pid=1983818)[0m The lowest number you can get $7 + (30×N)$ and the number to have only one larger number divisors, which are not the full equality. Is therefore:

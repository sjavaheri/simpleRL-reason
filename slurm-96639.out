[36m(main_task pid=1983818)[0m 
[36m(main_task pid=1983818)[0m # Area of each of the 8 pieces once equal in size
[36m(main_task pid=1983818)[0m area_each_piece = area_triangle / 2
[36m(main_task pid=1983818)[0m 

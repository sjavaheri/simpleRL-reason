[36m(main_task pid=1983818)[0m \[
[36m(main_task pid=1983818)[0m \boxed{-5\sqrt{3}, -\sqrt{76}, -\sqrt{79}, -\sqrt{84}, -5\sqrt{3}, \sqrt{76}, \sqrt{79}, \sqrt{84}, -5\sqrt{3}}

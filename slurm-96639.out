[36m(main_task pid=1983818)[0m sum_of_angles1440 = 180
[36m(main_task pid=1983818)[0m 
[36m(main_task pid=1983818)[0m # Using supplementary angles
[36m(main_task pid=1983818)[0m # angle3 + angle4 = 180 - angle5
[36m(main_task pid=1983818)[0m # angle4 = 180 - (angle3 + angle4) + angle5
[36m(main_task pid=1983818)[0m # Since they form consecutive angles, we can assume angle5 = 0 degrees for this calculation

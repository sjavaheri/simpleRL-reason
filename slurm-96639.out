[36m(main_task pid=1983818)[0m 
[36m(main_task pid=1983818)[0m draw(unitcircle);
[36m(main_task pid=1983818)[0m 
[36m(main_task pid=1983818)[0m draw((0,0.8)--(0,-0.8),Arrows(HookHead));
[36m(main_task pid=1983818)[0m draw((-0.8,0)--(0.8,0),Arrows(HookHead));
[36m(main_task pid=1983818)[0m 

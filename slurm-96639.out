[36m(main_task pid=1983818)[0m def prime_factors_to_monotonically_increasing(level):
[36m(main_task pid=1983818)[0m     count = 0
[36m(main_task pid=1983818)[0m     
[36m(main_task pid=1983818)[0m     # Loop through each prime factor

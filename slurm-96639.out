[36m(main_task pid=1983818)[0m M_value = 2000
[36m(main_task pid=1983818)[0m total_employees = M_value
[36m(main_task pid=1983818)[0m L_value = 2000
[36m(main_task pid=1983818)[0m 
[36m(main_task pid=1983818)[0m # Check the solution
[36m(main_task pid=1983818)[0m print(f"L (M is equal to {L_value}; L is equal to 20)", M == L_value)
[36m(main_task pid=1983818)[0m print(f"Given the condition, M + L = {total_employees}. (True or False)")
[36m(main_task pid=1983818)[0m ```

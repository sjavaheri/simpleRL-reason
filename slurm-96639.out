[36m(main_task pid=1983818)[0m 
[36m(main_task pid=1983818)[0m Simplifying,
[36m(main_task pid=1983818)[0m \[
[36m(main_task pid=1983818)[0m l_{\text{max}} = \frac{32 \sqrt{32\pi}}{32\pi}
[36m(main_task pid=1983818)[0m \]

[36m(main_task pid=1983818)[0m label("$N$",(.777,.629),NE);
[36m(main_task pid=1983818)[0m label("$A$",(.777,-.629),SE);
[36m(main_task pid=1983818)[0m label("$P$",(-.777,-.629),SW);

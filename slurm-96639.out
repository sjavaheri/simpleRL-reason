[36m(main_task pid=1983818)[0m     }
[36m(main_task pid=1983818)[0m 
[36m(main_task pid=1983818)[0m     public int[] getStates() {
[36m(main_task pid=1983818)[0m         return states;
[36m(main_task pid=1983818)[0m     }
[36m(main_task pid=1983818)[0m 
[36m(main_task pid=1983818)[0m     public void setState(int stateIndex, byte[] states) {
[36m(main_task pid=1983818)[0m         this.states[stateIndex] = states;
[36m(main_task pid=1983818)[0m     }
[36m(main_task pid=1983818)[0m }
[36m(main_task pid=1983818)[0m ```

[36m(main_task pid=1983818)[0m 
[36m(main_task pid=1983818)[0m # Given equations
[36m(main_task pid=1983818)[0m # Total number of men wearing sunglasses (or women wearing sunglasses) = M
[36m(main_task pid=1983818)[0m # Used the above
[36m(main_task pid=1983818)[0m L = M
[36m(main_task pid=1983818)[0m 

[36m(main_task pid=1983818)[0m             counts[i] = True
[36m(main_task pid=1983818)[0m         else:
[36m(main_task pid=1983818)[0m             counts[i] = False
[36m(main_task pid=1983818)[0m     sums = list(counts.keys())
[36m(main_task pid=1983818)[0m 

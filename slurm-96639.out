[36m(main_task pid=1983818)[0m A paper equilateral triangle $ABC$ has side length 12. The paper triangle is folded so that vertex $A$ touches a point on side $\overline{BC}$ a distance 9 from point $B$. Find the square of the length of the line segment along which the triangle is folded.
[36m(main_task pid=1983818)[0m 
[36m(main_task pid=1983818)[0m [asy]
[36m(main_task pid=1983818)[0m import cse5;
[36m(main_task pid=1983818)[0m size(12cm);
[36m(main_task pid=1983818)[0m pen tpen = defaultpen + 1.337;
[36m(main_task pid=1983818)[0m real a = 39/5.0;
[36m(main_task pid=1983818)[0m real b = 39/7.0;
[36m(main_task pid=1983818)[0m pair B = MP("B", (0,0), dir(200));
[36m(main_task pid=1983818)[0m pair A = MP("A", (9,0), dir(-80));
[36m(main_task pid=1983818)[0m pair C = MP("C", (12,0), dir(-20));
[36m(main_task pid=1983818)[0m pair K = (6,10.392);
[36m(main_task pid=1983818)[0m pair M = (a*B+(12-a)*K) / 12;
[36m(main_task pid=1983818)[0m pair N = (b*C+(12-b)*K) / 12;
[36m(main_task pid=1983818)[0m draw(B--M--N--C--cycle, tpen);
[36m(main_task pid=1983818)[0m fill(M--A--N--cycle, mediumgrey);
[36m(main_task pid=1983818)[0m draw(M--A--N--cycle);
[36m(main_task pid=1983818)[0m pair shift = (-20.13, 0);

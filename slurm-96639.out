[36m(main_task pid=1983818)[0m 4^2 = 16
[36m(main_task pid=1983818)[0m 5^2 = 25
[36m(main_task pid=1983818)[0m 6^2 = 36
[36m(main_task pid=1983818)[0m 7^2 = 49

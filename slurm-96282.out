[36m(main_task pid=1419827)[0m 
[36m(main_task pid=1419827)[0m pair A = (0,0);
[36m(main_task pid=1419827)[0m pair B = A + right;
[36m(main_task pid=1419827)[0m pair C = A + up;
[36m(main_task pid=1419827)[0m 
[36m(main_task pid=1419827)[0m pair O = (1/3, 1/3);
[36m(main_task pid=1419827)[0m 
[36m(main_task pid=1419827)[0m pair Xprime = (1/3,2/3);
[36m(main_task pid=1419827)[0m pair Yprime = (2/3,1/3);

[36m(main_task pid=1419827)[0m label("$B$",B, down);
[36m(main_task pid=1419827)[0m label("$C$",C, left);
[36m(main_task pid=1419827)[0m label("$X$",(1/3,0), down);
[36m(main_task pid=1419827)[0m label("$Y$",(0,1/3), left);
[36m(main_task pid=1419827)[0m 

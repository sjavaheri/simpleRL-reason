[36m(main_task pid=1419827)[0m pair A,B,C,D,I,F,G;
[36m(main_task pid=1419827)[0m A=(0,0);
[36m(main_task pid=1419827)[0m B=(5,0);
[36m(main_task pid=1419827)[0m C=(5,3);
[36m(main_task pid=1419827)[0m D=(0,3);

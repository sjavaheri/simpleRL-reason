[36m(main_task pid=1419827)[0m \[14(7) - 10(7)y - y = 166,\]
[36m(main_task pid=1419827)[0m \[98 - 70y - y = 166,\]
[36m(main_task pid=1419827)[0m \[98 - 71y = 166,\]

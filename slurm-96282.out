[36m(main_task pid=1419827)[0m draw(5sqrt(3)*dir(60)+1*dir(-120)--(5sqrt(3)-1)*dir(60)+1*dir(-30)--5sqrt(3)*dir(60)+1*dir(-30),linewidth(1));

[36m(main_task pid=1419827)[0m \]
[36m(main_task pid=1419827)[0m \[
[36m(main_task pid=1419827)[0m = 251 \cdot 2(prs + qs + rt + tr + 2st)
[36m(main_task pid=1419827)[0m \]
[36m(main_task pid=1419827)[0m \[
[36m(main_task pid=1419827)[0m = 251 \cdot 2 \cdot (ps + qs + rp + rt + r + t)
[36m(main_task pid=1419827)[0m \]
[36m(main_task pid=1419827)[0m \[
[36m(main_task pid=1419827)[0m = 502 \cdot (ps + qs + rp + rt + r + t)
[36m(main_task pid=1419827)[0m \]
[36m(main_task pid=1419827)[0m \[

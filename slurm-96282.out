[36m(main_task pid=1419827)[0m //markangle(n=1,radius=15,X,C,B,marker(markinterval(stickframe(n=1),true)));
[36m(main_task pid=1419827)[0m 
[36m(main_task pid=1419827)[0m label("$28$",.5*(B+X),SE);
[36m(main_task pid=1419827)[0m label("$30$",.5*(B+C),N);
[36m(main_task pid=1419827)[0m label("$21$",.5*(A+C),NW);
[36m(main_task pid=1419827)[0m 

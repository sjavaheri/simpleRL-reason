[36m(main_task pid=1419827)[0m [asy]
[36m(main_task pid=1419827)[0m unitsize(3 cm);
[36m(main_task pid=1419827)[0m 
[36m(main_task pid=1419827)[0m pair A, B, C, D, E, F, G, H;
[36m(main_task pid=1419827)[0m 
[36m(main_task pid=1419827)[0m F = (0,0);
[36m(main_task pid=1419827)[0m G = (1,0);
[36m(main_task pid=1419827)[0m D = (1,1);
[36m(main_task pid=1419827)[0m E = (0,1);
[36m(main_task pid=1419827)[0m H = (E + F)/2;
[36m(main_task pid=1419827)[0m A = reflect(D,H)*(G);
[36m(main_task pid=1419827)[0m B = reflect(D,H)*(F);
[36m(main_task pid=1419827)[0m C = reflect(D,H)*(E);
[36m(main_task pid=1419827)[0m 
[36m(main_task pid=1419827)[0m draw(A--B--C--D--cycle);
[36m(main_task pid=1419827)[0m draw(D--E--F--G--cycle);

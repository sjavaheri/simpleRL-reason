[36m(main_task pid=1419827)[0m 
[36m(main_task pid=1419827)[0m # Calculate the mean of the numbers
[36m(main_task pid=1419827)[0m mean = sum(x) / len(x)
[36m(main_task pid=1419827)[0m 
[36m(main_task pid=1419827)[0m # Calculate the result
[36m(main_task pid=1419827)[0m result = mean - median

[36m(main_task pid=1419827)[0m &\text{Base}\ (&62, 2) & \equiv & \left\{ \sum x_k \cdot \frac{\text{\_2^k}}{62} \right\} \pmod{62}\\\\
[36m(main_task pid=1419827)[0m &\equiv \left \{ 1+5+26+50+25\right \} \pmod {62} = \mathbf{0}.
[36m(main_task pid=1419827)[0m \end{array}
[36m(main_task pid=1419827)[0m $$

[36m(main_task pid=1419827)[0m label("$E$", (4.8,2), NE);
[36m(main_task pid=1419827)[0m label("$F$", (5.3,1.05), SE);
[36m(main_task pid=1419827)[0m label("$G$", (4.3, 1.05), SE);

[36m(main_task pid=1419827)[0m    \]
[36m(main_task pid=1419827)[0m    \[
[36m(main_task pid=1419827)[0m    72 \div 8 = 9 \quad \text{(an integer, so 8 is a divisor)}
[36m(main_task pid=1419827)[0m    \]
[36m(main_task pid=1419827)[0m    \[
[36m(main_task pid=1419827)[0m    72 \div 9 = 8 \quad \text{(an integer, so 9 is a divisor)}

[36m(main_task pid=1419827)[0m \]
[36m(main_task pid=1419827)[0m \[
[36m(main_task pid=1419827)[0m AB = \sqrt{15^2}
[36m(main_task pid=1419827)[0m \]
[36m(main_task pid=1419827)[0m \[
[36m(main_task pid=1419827)[0m AB = \sqrt{225}
[36m(main_task pid=1419827)[0m \]
[36m(main_task pid=1419827)[0m \[
[36m(main_task pid=1419827)[0m AB = 15
[36m(main_task pid=1419827)[0m \]
[36m(main_task pid=1419827)[0m 
[36m(main_task pid=1419827)[0m 2. Distance \( BC \):
[36m(main_task pid=1419827)[0m \[
[36m(main_task pid=1419827)[0m BC = \sqrt{(9 - 9)^2 + (-2 - 6)^2}
[36m(main_task pid=1419827)[0m \]
[36m(main_task pid=1419827)[0m \[

[36m(main_task pid=1419827)[0m In triangle $ABC,$ points $D$ and $E$ are on $\overline{AB}$ and $\overline{AC},$ respectively, and angle bisector $\overline{AT}$ intersects $\overline{DE}$ at $F.$  If $AD = 1,$ $DB = 3,$ $AE = 2,$ and $EC = 4,$ compute $\frac{AF}{AT}.$
[36m(main_task pid=1419827)[0m 
[36m(main_task pid=1419827)[0m [asy]
[36m(main_task pid=1419827)[0m unitsize(1 cm);
[36m(main_task pid=1419827)[0m 
[36m(main_task pid=1419827)[0m pair A, B, C, D, E, F, T;
[36m(main_task pid=1419827)[0m 
[36m(main_task pid=1419827)[0m B = (0,0);
[36m(main_task pid=1419827)[0m C = (5,0);
[36m(main_task pid=1419827)[0m A = intersectionpoint(arc(B,4,0,180),arc(C,6,0,180));
[36m(main_task pid=1419827)[0m D = interp(A,B,1/4);
[36m(main_task pid=1419827)[0m E = interp(A,C,2/6);
[36m(main_task pid=1419827)[0m T = extension(A, incenter(A,B,C), B, C);
[36m(main_task pid=1419827)[0m F = extension(A, T, D, E);
[36m(main_task pid=1419827)[0m 
[36m(main_task pid=1419827)[0m draw(A--B--C--cycle);
[36m(main_task pid=1419827)[0m draw(A--T);
[36m(main_task pid=1419827)[0m draw(D--E);
[36m(main_task pid=1419827)[0m 
[36m(main_task pid=1419827)[0m label("$A$", A, N);
[36m(main_task pid=1419827)[0m label("$B$", B, SW);
[36m(main_task pid=1419827)[0m label("$C$", C, SE);
[36m(main_task pid=1419827)[0m label("$D$", D, W);
[36m(main_task pid=1419827)[0m label("$E$", E, NE);
[36m(main_task pid=1419827)[0m label("$F$", F, SW);
[36m(main_task pid=1419827)[0m label("$T$", T, S);
[36m(main_task pid=1419827)[0m [/asy]

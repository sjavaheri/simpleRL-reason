[36m(main_task pid=1419827)[0m eq2 = Eq(sqrt((x - 8)**2 + y**2), 15)
[36m(main_task pid=1419827)[0m eq3 = Eq(sqrt(x**2 + y**2), 8)
[36m(main_task pid=1419827)[0m 
[36m(main_task pid=1419827)[0m # Solve the system of equations
[36m(main_task pid=1419827)[0m solution = solve((eq1, eq2, eq3), (x, y))
[36m(main_task pid=1419827)[0m print(solution)
[36m(main_task pid=1419827)[0m ```

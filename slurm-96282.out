[36m(main_task pid=1419827)[0m unitsize(0.4 cm);
[36m(main_task pid=1419827)[0m 
[36m(main_task pid=1419827)[0m pair A, B, C, D;
[36m(main_task pid=1419827)[0m 
[36m(main_task pid=1419827)[0m A = (0,0);
[36m(main_task pid=1419827)[0m B = (7,2);
[36m(main_task pid=1419827)[0m C = (1,3);
[36m(main_task pid=1419827)[0m D = B + C;
[36m(main_task pid=1419827)[0m 
[36m(main_task pid=1419827)[0m draw(A--B,Arrow(6));
[36m(main_task pid=1419827)[0m draw(A--C,Arrow(6));
[36m(main_task pid=1419827)[0m draw(B--D--C);
[36m(main_task pid=1419827)[0m [/asy]
[36m(main_task pid=1419827)[0m Please reason step by step, and put your final answer within \boxed{{}}.<|im_end|>

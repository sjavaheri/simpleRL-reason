[36m(main_task pid=1419827)[0m eq2 = sp.Eq(p.subs(x, 2), 2)
[36m(main_task pid=1419827)[0m eq3 = sp.Eq(p.subs(x, 3), 3)
[36m(main_task pid=1419827)[0m eq4 = sp.Eq(p.subs(x, 4), 4)
[36m(main_task pid=1419827)[0m eq5 = sp.Eq(p.subs(x, 5), 5)
[36m(main_task pid=1419827)[0m eq6 = sp.Eq(p.subs(x, 6), 6)
[36m(main_task pid=1419827)[0m 
[36m(main_task pid=1419827)[0m # Solve the system of equations
[36m(main_task pid=1419827)[0m solution = sp.solve((eq1, eq2, eq3, eq4, eq5, eq6), (a, b, c, d, e, f))

[36m(main_task pid=1419827)[0m pair A=(0,0);
[36m(main_task pid=1419827)[0m pair B=(3,2);
[36m(main_task pid=1419827)[0m pair C=(.5,1.5);
[36m(main_task pid=1419827)[0m pair X=t*A+(1-t)*B;
[36m(main_task pid=1419827)[0m 

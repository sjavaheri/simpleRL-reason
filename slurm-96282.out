[36m(main_task pid=1419827)[0m Three congruent isosceles triangles $DAO,$ $AOB,$ and $OBC$ have $AD=AO=OB=BC=10$ and $AB=DO=OC=12.$ These triangles are arranged to form trapezoid $ABCD,$ as shown. Point $P$ is on side $AB$ so that $OP$ is perpendicular to $AB.$ [asy]
[36m(main_task pid=1419827)[0m pair A, B, C, D, O, P;
[36m(main_task pid=1419827)[0m A= (6, 8);
[36m(main_task pid=1419827)[0m B=(18, 8);
[36m(main_task pid=1419827)[0m C=(24, 0);
[36m(main_task pid=1419827)[0m D=(0,0);

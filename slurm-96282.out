[36m(main_task pid=1419827)[0m    \Rightarrow (rs + st)^2 - (rs - st)^2 = 2[25 - 2(rs + st)^2 - (rs^2 - 2rsst + st^2 - r^2 s^2 + r^2 t^2 + s^2 r^2 - s^2 t^2)]
[36m(main_task pid=1419827)[0m    \]
[36m(main_task pid=1419827)[0m    \[
[36m(main_task pid=1419827)[0m    \Rightarrow (rs + st)^2 - (rs - st)^2 = 2[25 - 2(rs + st)^2 - (rs^2 - 2rsst + st^2 - r^2 s^2 + r^2 t^2 + s^2 r^2 - s^2 t^2)]
[36m(main_task pid=1419827)[0m    \]
[36m(main_task pid=1419827)[0m    \[
[36m(main_task pid=1419827)[0m    \Rightarrow (rs + st)^2 - (rs - st)^2 = 2[25 - 2(rs + st)^2 - (rs^2 - 2rsst + st^2 - r^2 s^2 + r^2 t^2 + s^2 r^2 - s^2 t^2)]
[36m(main_task pid=1419827)[0m    \]
[36m(main_task pid=1419827)[0m    \[
[36m(main_task pid=1419827)[0m    \Rightarrow (rs + st)^2 - (rs - st)^2 = 2[25 - 2(rs + st)^2 - (rs^2 - 2rsst + st^2 - r^2 s^2 + r^2 t^2 + s^2 r^2 - s^2 t^2)]
[36m(main_task pid=1419827)[0m    \]
[36m(main_task pid=1419827)[0m    \[
[36m(main_task pid=1419827)[0m    \Rightarrow (rs + st)^2 - (rs - st)^2 = 2[25 - 2(rs + st)^2 - (rs^2 - 2rsst + st^2 - r^2 s^2 + r^2 t^2 + s^2 r^2 - s^2 t^2)]
[36m(main_task pid=1419827)[0m    \]
[36m(main_task pid=1419827)[0m    \[
[36m(main_task pid=1419827)[0m    \Rightarrow (rs + st)^2 - (rs - st)^2 = 2[25 - 2(rs + st)^2 - (rs^2 - 2rsst + st^2 - r^2 s^2 + r^2 t^2 + s^2 r^2 - s^2 t^2)]
[36m(main_task pid=1419827)[0m    \]

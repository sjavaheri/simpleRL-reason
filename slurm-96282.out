[36m(main_task pid=1419827)[0m    \]
[36m(main_task pid=1419827)[0m    \[
[36m(main_task pid=1419827)[0m    72 \div 11 = 6.545 \quad \text{(not an integer, so 11 is not a divisor)}
[36m(main_task pid=1419827)[0m    \]
[36m(main_task pid=1419827)[0m    \[
[36m(main_task pid=1419827)[0m    72 \div 12 = 6 \quad \text{(an integer, so 12 is a divisor)}
[36m(main_task pid=1419827)[0m    \]
[36m(main_task pid=1419827)[0m    \[
[36m(main_task pid=1419827)[0m    72 \div 13 = 5.538 \quad \text{(not an integer, so 13 is not a divisor)}
[36m(main_task pid=1419827)[0m    \]
[36m(main_task pid=1419827)[0m    \[
[36m(main_task pid=1419827)[0m    72 \div 14 = 5.143 \quad \text{(not an integer, so 14 is not a divisor)}
[36m(main_task pid=1419827)[0m    \]
[36m(main_task pid=1419827)[0m    \[
[36m(main_task pid=1419827)[0m    72 \div 15 = 4.8 \quad \text{(not an integer, so 15 is not a divisor)}

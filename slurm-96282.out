[36m(main_task pid=1419827)[0m \[
[36m(main_task pid=1419827)[0m \frac{3}{5} + \frac{2}{5} = \frac{5}{5} = 1
[36m(main_task pid=1419827)[0m \]
[36m(main_task pid=1419827)[0m 

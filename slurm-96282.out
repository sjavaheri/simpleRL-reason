[36m(main_task pid=1419827)[0m draw((5.5,-4)--(0,-4),EndArrow);
[36m(main_task pid=1419827)[0m draw((8.5,-4)--(14,-4),black+linewidth(1));
[36m(main_task pid=1419827)[0m draw((8.5,-4)--(14,-4),EndArrow);
[36m(main_task pid=1419827)[0m label("$A$",(7,24),N);

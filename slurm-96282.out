[36m(main_task pid=1419827)[0m \]
[36m(main_task pid=1419827)[0m 
[36m(main_task pid=1419827)[0m Now, sum the results:
[36m(main_task pid=1419827)[0m 
[36m(main_task pid=1419827)[0m \[
[36m(main_task pid=1419827)[0m \mathbf{c} \times (3 \mathbf{a} - 2 \mathbf{b}) = (3a_2 a_3 \mathbf{i} - 3a_1 a_3 \mathbf{j} - 3a_1 a_2 \mathbf{k}) + (2b_1 b_3 (b_2 - b_1) - 4b_1^2 b_2 - 2b_1 b_3 b_2) \mathbf{i} + (2b_2 b_3 b_1 - 2b_2 b_1 b_1) \mathbf{j} + (2b_3 b_1 b_2 - 2b_3 b_2 b_1) \mathbf{k}
[36m(main_task pid=1419827)[0m \]
[36m(main_task pid=1419827)[0m 
[36m(main_task pid=1419827)[0m Combine like terms:
[36m(main_task pid=1419827)[0m 
[36m(main_task pid=1419827)[0m \[

[36m(main_task pid=1419827)[0m In the diagram, the length of $DC$ is twice the length of $BD.$ What is the area of the triangle $ABC?$ [asy]
[36m(main_task pid=1419827)[0m draw((0,0)--(-3,0)--(0,4)--cycle);
[36m(main_task pid=1419827)[0m draw((0,0)--(6,0)--(0,4)--cycle);
[36m(main_task pid=1419827)[0m label("3",(-1.5,0),N);
[36m(main_task pid=1419827)[0m label("4",(0,2),E);
[36m(main_task pid=1419827)[0m label("$A$",(0,4),N);
[36m(main_task pid=1419827)[0m label("$B$",(-3,0),S);
[36m(main_task pid=1419827)[0m label("$C$",(6,0),S);
[36m(main_task pid=1419827)[0m label("$D$",(0,0),S);

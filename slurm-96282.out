[36m(main_task pid=1419827)[0m &16: \text{ factors: } 1, 2, 4, 8 \\
[36m(main_task pid=1419827)[0m &17: \text{ factors: } 1 \\
[36m(main_task pid=1419827)[0m &18: \text{ factors: } 1, 2, 3, 6, 9 \\
[36m(main_task pid=1419827)[0m &19: \text{ factors: } 1 \\
[36m(main_task pid=1419827)[0m &20: \text{ factors: } 1, 2, 4, 5, 10 \\

[36m(main_task pid=1419827)[0m \]
[36m(main_task pid=1419827)[0m 
[36m(main_task pid=1419827)[0m Now, compute the cross product:
[36m(main_task pid=1419827)[0m 
[36m(main_task pid=1419827)[0m \[
[36m(main_task pid=1419827)[0m \mathbf{c} \times 2 \mathbf{b} = \begin{pmatrix} 2b_1 \\ 2b_2 \\ 2b_3 \end{pmatrix} \times \begin{pmatrix} b_1 \\ b_2 \\ b_3 \end{pmatrix} = 2b_1 (b_2 \cdot b_3 - b_3 \cdot b_2) - 2b_2 (b_1 \cdot b_3 - b_3 \cdot b_1) + 2b_3 (b_1 \cdot b_2 - b_2 \cdot b_1)
[36m(main_task pid=1419827)[0m \]
[36m(main_task pid=1419827)[0m 
[36m(main_task pid=1419827)[0m Substitute the given values:
[36m(main_task pid=1419827)[0m 
[36m(main_task pid=1419827)[0m \[
[36m(main_task pid=1419827)[0m \begin{pmatrix} 2b_1 \\ 2b_2 \\ 2b_3 \end{pmatrix} \times \begin{pmatrix} b_1 \\ b_2 \\ b_3 \end{pmatrix} = 2b_1 (b_2 \cdot b_3 - b_3 \cdot b_2) - 2b_2 (b_1 \cdot b_3 - b_3 \cdot b_1) + 2b_3 (b_1 \cdot b_2 - b_2 \cdot b_1)
[36m(main_task pid=1419827)[0m \]
[36m(main_task pid=1419827)[0m 
[36m(main_task pid=1419827)[0m Substitute known values:
[36m(main_task pid=1419827)[0m 
[36m(main_task pid=1419827)[0m \[
[36m(main_task pid=1419827)[0m 2b_1 (b_2 b_3 - b_3 b_2) - 2b_2 (b_1 b_3 - b_3 b_1) + 2b_3 (b_1 b_2 - b_2 b_1) = 2b_1 b_3 (b_2 - b_1) - 2b_2 b_3 (b_1 - b_1) + 2b_3 b_2 (b_1 - b_1)
[36m(main_task pid=1419827)[0m \]
[36m(main_task pid=1419827)[0m 
[36m(main_task pid=1419827)[0m \[
[36m(main_task pid=1419827)[0m = 2b_1 b_3 (b_2 - b_1) - 2b_2 b_3 \cdot 2b_1 - 2b_3 b_2 b_1
[36m(main_task pid=1419827)[0m \]
[36m(main_task pid=1419827)[0m 
[36m(main_task pid=1419827)[0m \[

[36m(main_task pid=1419827)[0m 
[36m(main_task pid=1419827)[0m # Semi-perimeter
[36m(main_task pid=1419827)[0m s = (a + b + c) / 2
[36m(main_task pid=1419827)[0m 
[36m(main_task pid=1419827)[0m # Area using Heron's formula
[36m(main_task pid=1419827)[0m area = math.sqrt(s * (s - a) * (s - b) * (s - c))

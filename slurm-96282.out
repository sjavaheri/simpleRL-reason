[36m(main_task pid=1419827)[0m Let $PQRS$ be a square piece of paper. $P$ is folded onto $R$ and then $Q$ is folded onto $S$. The area of the resulting figure is 9 square inches. Find the perimeter of square $PQRS$. [asy]
[36m(main_task pid=1419827)[0m /* AMC8 1998 #20P */
[36m(main_task pid=1419827)[0m size(1inch,1inch);
[36m(main_task pid=1419827)[0m label("$P$", (0, 72), SE);
[36m(main_task pid=1419827)[0m label("$Q$", (72, 72), SW);
[36m(main_task pid=1419827)[0m label("$S$", (0, 0), NE);
[36m(main_task pid=1419827)[0m label("$R$", (72, 0), NW);
[36m(main_task pid=1419827)[0m draw((0,0)--(72,0)--(72,72)--(0,72)--cycle);
[36m(main_task pid=1419827)[0m [/asy]

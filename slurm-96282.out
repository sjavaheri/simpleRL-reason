[36m(main_task pid=1419827)[0m In the diagram, if $\triangle ABC$ and $\triangle PQR$ are equilateral, then what is the measure of $\angle CXY$ in degrees? [asy]
[36m(main_task pid=1419827)[0m import cse5;
[36m(main_task pid=1419827)[0m size(8cm);
[36m(main_task pid=1419827)[0m draw((-0.8, 0)--(1.5, 0));
[36m(main_task pid=1419827)[0m pair b = (0, 0); pair p = (0.75, 0);
[36m(main_task pid=1419827)[0m pair a = dir(180 - 65); pair c = dir(55);
[36m(main_task pid=1419827)[0m pair q = shift(p) * (1.7 * dir(75)); pair r = shift(p) * (1.7 * dir(60 + 75));
[36m(main_task pid=1419827)[0m draw(a--b--c--cycle); draw(p--q--r--cycle);
[36m(main_task pid=1419827)[0m 
[36m(main_task pid=1419827)[0m label("$B$", b, S); label("$P$", p, S); label("$R$", r, NW); label("$Q$", q, NE);
[36m(main_task pid=1419827)[0m label("$A$", a, W); label("$C$", c, E); label("$X$", IP(r--p, a--c), NE); label("$Y$", IP(r--p, c--b), 2 * E);
[36m(main_task pid=1419827)[0m 
[36m(main_task pid=1419827)[0m label("$65^\circ$", b, W + NW+ NW); label("$75^\circ$", p, 0.5 * E + NE + NE);
[36m(main_task pid=1419827)[0m [/asy]
[36m(main_task pid=1419827)[0m Please reason step by step, and put your final answer within \boxed{{}}.<|im_end|>

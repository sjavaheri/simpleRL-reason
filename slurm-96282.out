[36m(main_task pid=1419827)[0m \[
[36m(main_task pid=1419827)[0m 1 \cdot 4^1 = 1 \cdot 4 = 4
[36m(main_task pid=1419827)[0m \]
[36m(main_task pid=1419827)[0m \[

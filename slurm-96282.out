[36m(main_task pid=1419827)[0m 
[36m(main_task pid=1419827)[0m \[
[36m(main_task pid=1419827)[0m 2(5)^2 + 8(5) + 4 = 2 \cdot 25 + 40 + 4 = 50 + 40 + 4 = 94 \neq 60
[36m(main_task pid=1419827)[0m \]

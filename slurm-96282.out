[36m(main_task pid=1419827)[0m \[
[36m(main_task pid=1419827)[0m 336 \times 5 = 1680
[36m(main_task pid=1419827)[0m \]
[36m(main_task pid=1419827)[0m \[
[36m(main_task pid=1419827)[0m 1680 \times 4 = 6720
[36m(main_task pid=1419827)[0m \]
[36m(main_task pid=1419827)[0m \[
[36m(main_task pid=1419827)[0m 6720 \times 3 = 20160
[36m(main_task pid=1419827)[0m \]
[36m(main_task pid=1419827)[0m \[
[36m(main_task pid=1419827)[0m 20160 \times 2 = 40320
[36m(main_task pid=1419827)[0m \]
[36m(main_task pid=1419827)[0m \[

[36m(main_task pid=1419827)[0m What is the volume of a pyramid whose base is one face of a cube of side length $2$, and whose apex is the center of the cube? Give your answer in simplest form.
[36m(main_task pid=1419827)[0m 
[36m(main_task pid=1419827)[0m [asy]
[36m(main_task pid=1419827)[0m import three;
[36m(main_task pid=1419827)[0m triple A,B,C,D,EE,F,G,H;
[36m(main_task pid=1419827)[0m A = (0,0,0);
[36m(main_task pid=1419827)[0m B = (1,0,0);
[36m(main_task pid=1419827)[0m C = (1,1,0);
[36m(main_task pid=1419827)[0m D= (0,1,0);
[36m(main_task pid=1419827)[0m EE = (0,0,1);
[36m(main_task pid=1419827)[0m F = B+EE;
[36m(main_task pid=1419827)[0m G = C + EE;
[36m(main_task pid=1419827)[0m H = D + EE;
[36m(main_task pid=1419827)[0m O = G/2;
[36m(main_task pid=1419827)[0m draw(surface(B--O--C--cycle),red,nolight);
[36m(main_task pid=1419827)[0m draw(surface(C--O--D--cycle),red+white,nolight);
[36m(main_task pid=1419827)[0m draw(B--C--D);
[36m(main_task pid=1419827)[0m draw(B--A--D,dashed);
[36m(main_task pid=1419827)[0m draw(EE--F--G--H--EE);
[36m(main_task pid=1419827)[0m draw(A--EE,dashed);
[36m(main_task pid=1419827)[0m draw(B--F);
[36m(main_task pid=1419827)[0m draw(C--G);
[36m(main_task pid=1419827)[0m draw(D--H);
[36m(main_task pid=1419827)[0m draw(A--O--C,dashed);
[36m(main_task pid=1419827)[0m draw(B--O--D,dashed);
[36m(main_task pid=1419827)[0m dot(A); dot(B); dot(C); dot(D); dot(EE); dot(F); dot(G); dot(H); dot(O);
[36m(main_task pid=1419827)[0m [/asy]
[36m(main_task pid=1419827)[0m Please reason step by step, and put your final answer within \boxed{{}}.<|im_end|>

[36m(main_task pid=1419827)[0m \]
[36m(main_task pid=1419827)[0m Substituting \( x = 20 \):
[36m(main_task pid=1419827)[0m \[
[36m(main_task pid=1419827)[0m P = 4 \times 20
[36m(main_task pid=1419827)[0m \]
[36m(main_task pid=1419827)[0m \[
[36m(main_task pid=1419827)[0m P = 80
[36m(main_task pid=1419827)[0m \]

[36m(main_task pid=1419827)[0m \[ x = \sqrt{5 + \sqrt{21}} \]
[36m(main_task pid=1419827)[0m \[ y = \sqrt{5 - \sqrt{21}} \]
[36m(main_task pid=1419827)[0m 

[36m(main_task pid=1419827)[0m &24: \text{ factors: } 1, 2, 3, 4, 6, 8, 12, 24 \\
[36m(main_task pid=1419827)[0m \end{aligned}
[36m(main_task pid=1419827)[0m \]
[36m(main_task pid=1419827)[0m 
[36m(main_task pid=1419827)[0m Now, we calculate the sum of each number's proper factors:
[36m(main_task pid=1419827)[0m 
[36m(main_task pid=1419827)[0m \[
[36m(main_task pid=1419827)[0m \begin{aligned}
[36m(main_task pid=1419827)[0m &1: \quad \text{sum} = 1\\
[36m(main_task pid=1419827)[0m &2: \quad \text{sum} = 1+2 = 3\\
[36m(main_task pid=1419827)[0m &3: \quad \text{sum} = 1+3 = 4\\

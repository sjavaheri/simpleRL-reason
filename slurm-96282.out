[36m(main_task pid=1419827)[0m \[ q(x) = a(x^4 - x^3 + x^2 - 4x^2 + 6x - 2) \]
[36m(main_task pid=1419827)[0m \[ q(x) = a(x^4 - x^3 + x^2 - 4x^2 + 6x - 2) \]
[36m(main_task pid=1419827)[0m \[ q(x) = a(x^4 - x^3 + x^2 - 4x^2 + 6x - 2) \]
[36m(main_task pid=1419827)[0m 
[36m(main_task pid=1419827)[0m ### Step 4: Use the condition \(q(3) = -30\)
[36m(main_task pid=1419827)[0m \[ q(3) = a(3^4 - 3^3 + 3^2 - 4 \cdot 3^2 + 6 \cdot 3 - 2) \]
[36m(main_task pid=1419827)[0m \[ q(3) = a(81 - 27 + 9 - 36 + 18 - 2) \]

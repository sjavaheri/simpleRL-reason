[36m(main_task pid=1419827)[0m \[ 15a_1 + 210k + 695 + 14ka_1 + 14ka_1 + k^2a_1 + 14ka_1 + 47k = 1672 \]
[36m(main_task pid=1419827)[0m \[ (16a_1 + 14ka_1 + 210k + k^2a_1 + 47k) + 75ka_1 = 1672 \]
[36m(main_task pid=1419827)[0m \[ 16a_1 + k^2a_1 + 210k + 150ka_1 = 1672 \]
[36m(main_task pid=1419827)[0m \[ (16 + k)^2a_1 + 210k + 150k = 1672 \]

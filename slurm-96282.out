[36m(main_task pid=1419827)[0m sums = [sum(prime_numbers[:i+1]) for i in range(12)]
[36m(main_task pid=1419827)[0m 
[36m(main_task pid=1419827)[0m # Check how many sums are prime
[36m(main_task pid=1419827)[0m prime_sums = [num for num in sums if isprime(num)]
[36m(main_task pid=1419827)[0m 
[36m(main_task pid=1419827)[0m # Output the result
[36m(main_task pid=1419827)[0m print((sums, prime_sums))
[36m(main_task pid=1419827)[0m ```

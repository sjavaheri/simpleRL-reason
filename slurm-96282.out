[36m(main_task pid=1419827)[0m draw(p,(P--Q--R--S1--T--cycle),linewidth(1)); pair X = (S1+T)/2;
[36m(main_task pid=1419827)[0m label(p,rotate(20)*"$P$",P,rotate(20)*W,fontsize(10pt)); label(p,rotate(20)*"$Q$",Q,rotate(20)*NW,fontsize(10pt)); label(p,rotate(20)*"$R$",R,S,fontsize(10pt)); label(p,rotate(20)*"$S$",S1,rotate(20)*E,fontsize(10pt)); label(p,rotate(20)*"$T$",T,rotate(20)*N,fontsize(10pt));label(p,rotate(20)*"$X$",X,rotate(-40)*NE,fontsize(10pt));
[36m(main_task pid=1419827)[0m dot(p,X);

[36m(main_task pid=1419827)[0m \]
[36m(main_task pid=1419827)[0m \[
[36m(main_task pid=1419827)[0m = 502 \cdot 0 = 0
[36m(main_task pid=1419827)[0m \]
[36m(main_task pid=1419827)[0m 

[36m(main_task pid=1419827)[0m 
[36m(main_task pid=1419827)[0m [asy]
[36m(main_task pid=1419827)[0m import olympiad;
[36m(main_task pid=1419827)[0m import math;
[36m(main_task pid=1419827)[0m import graph;
[36m(main_task pid=1419827)[0m 

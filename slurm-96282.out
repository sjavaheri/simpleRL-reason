[36m(main_task pid=1419827)[0m \theta_p = \theta_f = \theta_f - 25^\circ = \theta_f - 25^\circ = \theta_f - 25^\circ = \theta_f - 25^\circ = \theta_f - 25^\circ = \theta_f - 25^\circ = \theta_f - 25^\circ = \theta_f - 25^\circ = \theta_f - 25^\circ = \theta_f - 25^\circ = \theta_f - 25^\circ = \theta_f - 25^\circ = \theta_f - 25^\circ = \theta_f - 25^\circ = \theta_f - 25^\circ = \theta_f - 25^\circ = \theta_f - 25^\circ = \theta_f - 25^\circ = \theta_f - 25^\circ = \theta_f - 25^\circ = \theta_f - 25^\circ = \theta_f - 25^\circ = \theta_f - 25^\circ = \theta_f - 25^\circ = \theta_f - 25^\circ = \theta_f - 25^\circ = \theta_f - 25^\circ = \theta_f - 25^\circ = \theta_f - 25^\circ = \theta_f - 25^\circ = \theta_f - 25^\circ = \theta_f - 25^\circ = \theta_f - 25^\circ = \theta_f - 25^\circ = \theta_f - 25^\circ = \theta_f - 25^\circ = \theta_f - 25^\circ = \theta_f - 25^\circ = \theta_f - 25^\circ = \theta_f - 25^\circ = \theta_f - 25^\circ = \theta_f - 25^\circ = \theta_f - 25^\circ = \theta_f - 25^\circ = \theta_f - 25^\circ = \theta_f - 25^\circ = \theta_f - 25^\circ = \theta_f - 25^\circ = \theta_f - 25^\circ = \theta_f - 25^\circ = \theta_f - 25^\circ = \theta_f - 25^\circ = \theta_f - 25^\circ = \theta_f - 25^\circ = \theta_f - 25^\circ = \theta_f - 25^\circ = \theta_f - 25^\circ = \theta_f - 25^\circ = \theta_f - 25^\circ = \theta_f - 25^\circ = \theta_f - 25^\circ = \theta_f - 25^\circ = \theta_f - 25^\circ = \theta_f - 25^\circ = \theta_f - 25^\circ = \theta_f - 25^\circ = \theta_f - 25^\circ = \theta_f - 25^\circ = \theta_f - 25^\circ = \theta_f - 25^\circ = \theta_f - 25^\circ = \theta_f - 25^\circ = \theta_f - 25^\circ = \theta_f - 25^\circ = \theta_f - 25^\circ = \theta_f - 25^\circ = \theta_f - 25^\circ = \theta_f - 25^\circ = \theta_f - 25^\circ = \theta_f - 25^\circ = \theta_f - 25^\circ = \theta_f - 25^\circ = \theta_f - 25^\circ = \theta_f - 25^\circ = \theta_f - 25^\circ = \theta_f - 25^\circ = \theta_f - 25^\circ = \theta_f - 25^\circ = \theta_f 
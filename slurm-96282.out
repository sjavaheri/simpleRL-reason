[36m(main_task pid=1419827)[0m    \[
[36m(main_task pid=1419827)[0m    72 \div 17 = 4 \quad \text{(an integer, so 17 is a divisor)}
[36m(main_task pid=1419827)[0m    \]
[36m(main_task pid=1419827)[0m    \[
[36m(main_task pid=1419827)[0m    72 \div 18 = 4 \quad \text{(an integer, so 18 is a divisor)}

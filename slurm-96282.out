[36m(main_task pid=1419827)[0m 
[36m(main_task pid=1419827)[0m # Create the matrix
[36m(main_task pid=1419827)[0m matrix = np.array([[cos_1, cos_2, cos_3], 
[36m(main_task pid=1419827)[0m                     [cos_4, cos_5, cos_6], 
[36m(main_task pid=1419827)[0m                     [cos_7, cos_8, cos_9]])
[36m(main_task pid=1419827)[0m 
[36m(main_task pid=1419827)[0m # Compute the determinant
[36m(main_task pid=1419827)[0m det_A = np.linalg.det(matrix)

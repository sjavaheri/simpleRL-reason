[36m(main_task pid=1419827)[0m label("$D$",(7,0),S);
[36m(main_task pid=1419827)[0m label("25",(0,0)--(7,24),NW);
[36m(main_task pid=1419827)[0m label("25",(7,24)--(14,0),NE);
[36m(main_task pid=1419827)[0m label("14",(7,-4));
[36m(main_task pid=1419827)[0m [/asy]

[36m(main_task pid=1419827)[0m Bob placed three regular pentagons together at a vertex, thinking he might be able to form a tessellation. However, they left a gap. What is the number of degrees in the measure indicated? [asy]size(100);
[36m(main_task pid=1419827)[0m path A = dir(0) -- dir(72) -- dir (144) -- dir(216) -- dir (288) -- cycle;
[36m(main_task pid=1419827)[0m path B = reflect ( dir(72), dir(144)) * A;
[36m(main_task pid=1419827)[0m path C = reflect( dir(72), dir(0))* A;
[36m(main_task pid=1419827)[0m draw(rotate(18) *A);
[36m(main_task pid=1419827)[0m draw(rotate(18) *B);
[36m(main_task pid=1419827)[0m draw(rotate(18) *C);
[36m(main_task pid=1419827)[0m label("?", (0,1.5), N);

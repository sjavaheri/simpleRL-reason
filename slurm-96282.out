[36m(main_task pid=1419827)[0m string[] labels = {"$C$","$B$","$A$","$F$","$E$","$D$"};
[36m(main_task pid=1419827)[0m path p;
[36m(main_task pid=1419827)[0m for(int i = 0; i<6; ++i)
[36m(main_task pid=1419827)[0m {

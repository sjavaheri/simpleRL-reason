[36m(main_task pid=1419827)[0m    \]
[36m(main_task pid=1419827)[0m    \[
[36m(main_task pid=1419827)[0m    (243)^2 = 59049
[36m(main_task pid=1419827)[0m    \]
[36m(main_task pid=1419827)[0m 
[36m(main_task pid=1419827)[0m    Add the squares:
[36m(main_task pid=1419827)[0m    \[

[36m(main_task pid=1419827)[0m \[
[36m(main_task pid=1419827)[0m 2(y-4)^2 - 32 = 5(5 - x) + 64
[36m(main_task pid=1419827)[0m \]
[36m(main_task pid=1419827)[0m \[
[36m(main_task pid=1419827)[0m 2(y-4)^2 - 32 = 5(5 - x) + 64
[36m(main_task pid=1419827)[0m \]
[36m(main_task pid=1419827)[0m \[
[36m(main_task pid=1419827)[0m 2(y-4)^2 = 5(5 - x) + 96

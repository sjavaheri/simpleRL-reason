[36m(main_task pid=1419827)[0m \]
[36m(main_task pid=1419827)[0m \[
[36m(main_task pid=1419827)[0m 2x_1^2 - 24x_1 + 144 = 144
[36m(main_task pid=1419827)[0m \]
[36m(main_task pid=1419827)[0m \[

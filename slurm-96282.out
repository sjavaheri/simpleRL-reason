[36m(main_task pid=1419827)[0m    \[ 3^{2k+6} = 729 \]
[36m(main_task pid=1419827)[0m    \[ 3^{2k+7} = 2187 \]
[36m(main_task pid=1419827)[0m    \[ 3^{2k+8} = 729 \]
[36m(main_task pid=1419827)[0m    \[ 3^{2k+9} = 2187 \]

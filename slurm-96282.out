[36m(main_task pid=1419827)[0m \]
[36m(main_task pid=1419827)[0m \[
[36m(main_task pid=1419827)[0m \sin^2 B + \sin^2 C = \frac{18}{9} - \frac{14}{9} + 2 \sin B \sin C x
[36m(main_task pid=1419827)[0m \]
[36m(main_task pid=1419827)[0m \[
[36m(main_task pid=1419827)[0m \sin^2 C = 2 - \frac{14}{9} + 2 \sin B \sin C x
[36m(main_task pid=1419827)[0m \]
[36m(main_task pid=1419827)[0m \[
[36m(main_task pid=1419827)[0m \sin^2 C + \frac{14}{9} = 2 - \frac{14}{9} + 2 \sin B \sin C x
[36m(main_task pid=1419827)[0m \]
[36m(main_task pid=1419827)[0m \[
[36m(main_task pid=1419827)[0m \sin^2 C + \frac{14}{9} = 2 - \frac{14}{9} + 2 \sin B \sin C x
[36m(main_task pid=1419827)[0m \]
[36m(main_task pid=1419827)[0m \[
[36m(main_task pid=1419827)[0m \sin^2 C + \frac{14}{9} = 2 - \frac{14}{9} + 2 \sin B \sin C x
[36m(main_task pid=1419827)[0m \]
[36m(main_task pid=1419827)[0m 
[36m(main_task pid=1419827)[0m We now have the equations:
[36m(main_task pid=1419827)[0m 

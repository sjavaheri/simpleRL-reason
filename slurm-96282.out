[36m(main_task pid=1419827)[0m 
[36m(main_task pid=1419827)[0m \[
[36m(main_task pid=1419827)[0m 49c = 49
[36m(main_task pid=1419827)[0m \]
[36m(main_task pid=1419827)[0m 

[36m(main_task pid=1419827)[0m 
[36m(main_task pid=1419827)[0m size(4cm,4cm);
[36m(main_task pid=1419827)[0m 
[36m(main_task pid=1419827)[0m pair a1, b1, c1, d1;
[36m(main_task pid=1419827)[0m 

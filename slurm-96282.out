[36m(main_task pid=1419827)[0m label("$O$",(0,0),SE);
[36m(main_task pid=1419827)[0m label("$P$",(20,0),E);
[36m(main_task pid=1419827)[0m label("$X$",(12,0),SE);
[36m(main_task pid=1419827)[0m [/asy]

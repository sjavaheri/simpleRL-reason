[36m(main_task pid=1419827)[0m    \]
[36m(main_task pid=1419827)[0m    \[
[36m(main_task pid=1419827)[0m    2 \cdot 6^3 = 2 \cdot 216 = 432
[36m(main_task pid=1419827)[0m    \]
[36m(main_task pid=1419827)[0m    \[
[36m(main_task pid=1419827)[0m    5 \cdot 6^2 = 5 \cdot 36 = 180
[36m(main_task pid=1419827)[0m    \]
[36m(main_task pid=1419827)[0m    \[

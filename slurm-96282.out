[36m(main_task pid=1419827)[0m draw((1,0)..(0,1)..(-1,0)..(0,-1)..cycle);
[36m(main_task pid=1419827)[0m draw((0,0)--(4/5,3/5)--(-1,0)--(4/5,-3/5)--cycle);
[36m(main_task pid=1419827)[0m label("$O$",(0,0),W); label("$I$",(-1,0),W); label("$R$",(4/5,3/5),ENE); label("$P$",(4/5,-3/5),ESE);
[36m(main_task pid=1419827)[0m [/asy]
[36m(main_task pid=1419827)[0m Please reason step by step, and put your final answer within \boxed{{}}.<|im_end|>

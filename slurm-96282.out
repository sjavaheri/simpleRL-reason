[36m(main_task pid=1419827)[0m draw((0,0)--(6,0)--(6,8)--(0,8)--cycle);
[36m(main_task pid=1419827)[0m filldraw((0,0)--(5,-1)--(5,7)--(0,8)--cycle,fillpen=white);
[36m(main_task pid=1419827)[0m 

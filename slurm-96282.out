[36m(main_task pid=1419827)[0m unitsize(0.5 cm);
[36m(main_task pid=1419827)[0m 
[36m(main_task pid=1419827)[0m draw((3,0)--(4,0)--(4,1)--(5,1)--(5,2)--(6,2)--(6,3)--(7,3)--(7,4)--(6,4)--(6,5)--(5,5)--(5,6)--(4,6)--(4,7)--(3,7)--(3,6)--(2,6)--(2,5)--(1,5)--(1,4)--(0,4)--(0,3)--(1,3)--(1,2)--(2,2)--(2,1)--(3,1)--cycle);
[36m(main_task pid=1419827)[0m [/asy]
[36m(main_task pid=1419827)[0m Please reason step by step, and put your final answer within \boxed{{}}.<|im_end|>

[36m(main_task pid=1419827)[0m Y=(B+C)/2;
[36m(main_task pid=1419827)[0m Z=(C+D)/2;
[36m(main_task pid=1419827)[0m draw(A--B--C--A--E--D--F--B--C--D);
[36m(main_task pid=1419827)[0m draw(X--Y--Z--X, dashed);

[36m(main_task pid=1419827)[0m draw((15,0)--(15,6));
[36m(main_task pid=1419827)[0m draw((15,6)--(25.5,0));
[36m(main_task pid=1419827)[0m label("C",(25.5,0),E);
[36m(main_task pid=1419827)[0m label("B",(15,0),W);
[36m(main_task pid=1419827)[0m label("A",(15,6),W);[/asy]

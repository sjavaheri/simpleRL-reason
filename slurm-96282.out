[36m(main_task pid=1419827)[0m label("$A$",(-20,0),W);
[36m(main_task pid=1419827)[0m label("$B$",(0,8),N);
[36m(main_task pid=1419827)[0m label("$C$",(20,0),E);
[36m(main_task pid=1419827)[0m 

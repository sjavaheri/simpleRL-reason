[36m(main_task pid=3102311)[0m    10 \text{ (choices for } B\text{)}
[36m(main_task pid=3102311)[0m    \]
[36m(main_task pid=3102311)[0m    \[
[36m(main_task pid=3102311)[0m    10 \text{ (choices for } C\text{)}
[36m(main_task pid=3102311)[0m    \]
[36m(main_task pid=3102311)[0m    \[
[36m(main_task pid=3102311)[0m    10 \text{ (choices for } A\text{)}
[36m(main_task pid=3102311)[0m    \]
